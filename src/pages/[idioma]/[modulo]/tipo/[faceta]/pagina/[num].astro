---
/** Paginas 2 y siguientes de una categoria. La 1 vive en la raiz de la categoria. */
import Base from '../../../../../../layouts/Base.astro'
import Listado, { POR_PAGINA } from '../../../../../../components/Listado.astro'
import { categoriasDe } from '../index.astro'
import {
  codigosIdioma,
  modulos,
  ui,
  rutaModulo,
  entidadesDe,
  facetasDe
} from '../../../../../../lib/datos.js'

export function getStaticPaths() {
  return codigosIdioma.flatMap((idioma) =>
    modulos.flatMap((modulo) =>
      categoriasDe(modulo).flatMap((faceta) => {
        const cuantas = entidadesDe(modulo).filter((e) => facetasDe(e).includes(faceta)).length
        const total = Math.max(1, Math.ceil(cuantas / POR_PAGINA))
        return Array.from({ length: Math.max(0, total - 1) }, (_, i) => ({
          params: {
            idioma,
            modulo: rutaModulo(idioma, modulo),
            faceta,
            num: String(i + 2)
          },
          props: { modulo, faceta, pagina: i + 2 }
        }))
      })
    )
  )
}

const { idioma } = Astro.params
const { modulo, faceta, pagina } = Astro.props
---

<Base
  idioma={idioma}
  titulo={`${ui(idioma, `faceta.${faceta}`)} · ${ui(idioma, `nav.${modulo}`)} · ${pagina}`}
>
  <Listado idioma={idioma} modulo={modulo} faceta={faceta} pagina={pagina} />
</Base>
