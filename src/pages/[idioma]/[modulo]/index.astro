---
import Base from '../../../layouts/Base.astro'
import Listado from '../../../components/Listado.astro'
import { codigosIdioma, modulos, ui, rutaModulo } from '../../../lib/datos.js'

export function getStaticPaths() {
  return codigosIdioma.flatMap((idioma) =>
    modulos.map((modulo) => ({
      // El segmento de la URL va traducido: /es/encantamientos, /en/enchantments.
      params: { idioma, modulo: rutaModulo(idioma, modulo) },
      props: { modulo }
    }))
  )
}

const { idioma } = Astro.params
const { modulo } = Astro.props
---

<Base idioma={idioma} titulo={ui(idioma, `nav.${modulo}`)}>
  <Listado idioma={idioma} modulo={modulo} pagina={1} />
</Base>
