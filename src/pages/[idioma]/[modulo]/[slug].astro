---
import Base from '../../../layouts/Base.astro'
import Etapa from '../../../components/Etapa.astro'
import TarjetaEntidad from '../../../components/TarjetaEntidad.astro'
import Icono from '../../../components/Icono.astro'
import Apilamiento from '../../../components/Apilamiento.astro'
import Cuadricula from '../../../components/Cuadricula.astro'
import Construccion from '../../../components/Construccion.astro'
import {
  codigosIdioma,
  entidades,
  grafo,
  t,
  ui,
  rutaModulo,
  rutaDe,
  relacionesDe,
  facetasDe,
  familiaDe,
  grupoDe,
  comoSeConsigue
} from '../../../lib/datos.js'

export function getStaticPaths() {
  return codigosIdioma.flatMap((idioma) =>
    entidades.map(({ entidad, modulo }) => ({
      params: {
        idioma,
        modulo: rutaModulo(idioma, modulo),
        slug: t(idioma, entidad.id).slug
      },
      props: { id: entidad.id, modulo }
    }))
  )
}

const { idioma } = Astro.params
const { id, modulo } = Astro.props

const { entidad } = grafo.get(id)
const texto = t(idioma, id)

/**
 * Nombre y URL de otra entidad. Devuelve el identificador crudo si la entidad
 * no existe, en vez de reventar el build entero por una referencia suelta.
 */
const enlace = (otro) =>
  grafo.has(otro)
    ? { url: rutaDe(idioma, otro), nombre: t(idioma, otro).nombre }
    : { url: null, nombre: String(otro) }

// --- Datos numericos -------------------------------------------------------

const DATOS = {
  // "pila" no va aqui: se pinta aparte con icono, porque un numero suelto no
  // le dice nada a quien no conoce la jerga del inventario.
  item: [],
  encantamiento: [['ficha.nivelMaximo', 'nivelMaximo']],
  herramienta: [
    ['ficha.durabilidad', 'durabilidad'],
    ['ficha.dano', 'dano']
  ],
  armadura: [
    ['ficha.durabilidad', 'durabilidad'],
    ['ficha.puntosArmadura', 'puntosArmadura']
  ],
  mob: [
    ['ficha.dano', 'dano'],
    ['ficha.experiencia', 'experiencia']
  ]
}

const datos = (DATOS[entidad.tipo] ?? [])
  .filter(([, campo]) => entidad[campo] != null)
  .map(([clave, campo]) => ({ etiqueta: ui(idioma, clave), valor: entidad[campo] }))

if (entidad.vida) {
  datos.unshift({
    etiqueta: ui(idioma, 'ficha.vida'),
    valor: ui(idioma, 'ficha.corazones', { n: entidad.vida / 2 })
  })
}

if (entidad.duracionSegundos) {
  datos.push({
    etiqueta: ui(idioma, 'ficha.duracion'),
    valor:
      entidad.duracionSegundos >= 60
        ? ui(idioma, 'ficha.minutos', { n: Math.round(entidad.duracionSegundos / 60) })
        : ui(idioma, 'ficha.segundos', { n: entidad.duracionSegundos })
  })
}

if (entidad.produccionPorHora) {
  datos.push({
    etiqueta: ui(idioma, 'ficha.porHora'),
    valor: `${entidad.produccionPorHora.minimo} – ${entidad.produccionPorHora.maximo}`
  })
}

// --- Receta ----------------------------------------------------------------

/** Etiqueta de una casilla: el nombre si es uno solo, el grupo si son varios. */
const etiquetaOpciones = (opciones) => {
  if (!opciones?.length) return null
  if (opciones.length === 1) return enlace(opciones[0]).nombre
  const grupo = grupoDe(opciones)
  return grupo
    ? ui(idioma, `grupo.${grupo}`, { n: opciones.length })
    : ui(idioma, 'grupo.cualquiera', { n: opciones.length })
}

const ingredientes =
  entidad.tipo === 'receta'
    ? (entidad.ingredientes ??
      Object.entries(entidad.clave ?? {}).map(([letra, opciones]) => ({
        opciones,
        cantidad: (entidad.patron ?? []).join('').split('').filter((l) => l === letra).length
      })))
    : null

/**
 * Cadena de fabricacion de una pocion, desde la botella de agua hasta esta.
 *
 * Estaba repartida en dos relaciones sueltas al final de la ficha, "se hace a
 * partir de" y "se le anade", y ademas solo contaba el ultimo paso. Quien
 * entra a una pocion viene justo a esto, asi que va arriba y entero: con la
 * cadena completa no hace falta ir saltando de ficha en ficha para reunirla.
 */
const cadenaPocion = []
if (entidad.tipo === 'pocion') {
  let actual = entidad
  const vistas = new Set([entidad.id])
  while (actual?.derivaDe && grafo.has(actual.derivaDe)) {
    cadenaPocion.unshift({
      desde: actual.derivaDe,
      ingrediente: actual.ingrediente,
      hasta: actual.id
    })
    if (vistas.has(actual.derivaDe)) break
    vistas.add(actual.derivaDe)
    actual = grafo.get(actual.derivaDe).entidad
  }
}

// --- Relaciones ------------------------------------------------------------

// Lo que ya se muestra como tabla no se repite abajo como tarjetas.
const YA_EN_TABLA = {
  aldeano: ['rel.vende', 'rel.vendeEncantamiento', 'rel.aceptaComoPago'],
  // "Se construye con" ya sale dibujado arriba, con las cantidades.
  mob: ['rel.suelta', 'rel.seInvocaCon'],
  receta: ['rel.materiales'],
  pocion: ['rel.derivaDe', 'rel.ingrediente'],
  estructura: ['rel.exclusivo']
}

/**
 * Las recetas que dan esta cosa, con su cuadricula, aqui mismo.
 *
 * Antes solo salia una tarjeta al final que llevaba a la ficha de la receta:
 * dos pasos para responder a "y esto como se hace", que es de las preguntas
 * que mas trae a nadie a una wiki de Minecraft. Ahora se ve sin salir.
 *
 * Se pintan tres como mucho. Hay objetos que salen de siete recetas distintas
 * y entonces la cuadricula deja de ser una respuesta y pasa a ser una lista;
 * el resto siguen abajo como tarjetas.
 */
/**
 * "Por que ir" de una estructura.
 *
 * Lo exclusivo va arriba y solo, no mezclado con el botin de los cofres. Un
 * monumento oceanico tiene oro, prismarina y esponjas, pero solo la esponja es
 * un motivo para hacer el viaje: lo demas lo consigues sin salir de casa. Esa
 * es la diferencia entre "aqui hay cosas" y "tienes que venir aqui".
 */
const exclusivo = entidad.tipo === 'estructura' ? (entidad.exclusivo ?? []) : []

const MAXIMO_CUADRICULAS = 3

const relaciones = relacionesDe(id)

const recetasPropias =
  entidad.tipo === 'receta'
    ? []
    : (relaciones
        .find((g) => g.etiqueta === 'rel.comoSeHace')
        ?.ids.map((r) => grafo.get(r)?.entidad)
        .filter(Boolean) ?? [])

const cuadriculas = recetasPropias.slice(0, MAXIMO_CUADRICULAS)
const restantes = recetasPropias.slice(MAXIMO_CUADRICULAS).map((r) => r.id)

const grupos = relaciones
  .filter((g) => !(YA_EN_TABLA[entidad.tipo] ?? []).includes(g.etiqueta))
  // Lo que ya se ve como cuadricula no se repite abajo como tarjeta.
  .map((g) => (g.etiqueta === 'rel.comoSeHace' ? { ...g, ids: restantes } : g))
  .filter((g) => g.ids.length > 0)

/** "15" si la cantidad es fija, "15–16" si el juego la sortea. */
const rango = ({ minimo, maximo }) => (minimo === maximo ? `${minimo}` : `${minimo}–${maximo}`)

/**
 * Las etiquetas de la cabecera. La del mundo va primero y con su color, porque
 * responde a "donde me encuentro esto", que se pregunta antes que "que es".
 *
 * Los colores no son nuevos: son los de las etapas, donde el nether ya es rojo
 * y el end morado. Reutilizarlos ademas de ahorrar variables significa que el
 * mismo rojo quiere decir nether en toda la wiki.
 */
const COLOR_DIMENSION = {
  superficie: 'inicio',
  nether: 'nether',
  end: 'end'
}

const facetas = facetasDe(grafo.get(id)).sort(
  (a, b) => (COLOR_DIMENSION[b] ? 1 : 0) - (COLOR_DIMENSION[a] ? 1 : 0)
)

// "De donde saco esto" es la pregunta que mas se hace quien juega, asi que va
// arriba del todo y no enterrada entre las relaciones.
const obtencion = comoSeConsigue(id)

// Entidades hermanas. Va al final y con menos peso visual: es navegacion
// lateral, no informacion sobre esta ficha.
const parecidos = familiaDe(id)

// La advertencia no entra aqui: es una letra pequena, no un consejo. Como
// tarjeta al lado de los demas pesaba igual que ellos y robaba atencion a lo
// que si aporta.
const consejos = [texto.notas, texto.consejo].filter(Boolean)
---

<Base idioma={idioma} titulo={texto.nombre} descripcion={texto.descripcion} idEntidad={id}>
  <nav class="mb-3 flex items-center gap-2 text-sm text-texto-suave">
    <Icono modulo={modulo} clase="h-4 w-4" />
    <a href={`/${idioma}/${rutaModulo(idioma, modulo)}/`} class="font-semibold hover:text-acento">
      {ui(idioma, `nav.${modulo}`)}
    </a>
  </nav>

  <header class="mb-8 border-b-2 border-borde pb-5">
    <h1 class="text-4xl font-extrabold sm:text-5xl">{texto.nombre}</h1>

    <div class="mt-4 flex flex-wrap items-center gap-x-4 gap-y-2">
      <Etapa idioma={idioma} etapa={entidad.etapa} />
      {
        entidad.dificultad && (
          <span class="text-sm font-semibold">
            {ui(idioma, 'dificultad.etiqueta')}: {ui(idioma, `dificultad.${entidad.dificultad}`)}
          </span>
        )
      }
      {
        entidad.peligro && (
          <span class="text-sm font-semibold">
            {ui(idioma, 'estructura.peligro')}: {ui(idioma, `dificultad.${entidad.peligro}`)}
          </span>
        )
      }
      {entidad.pila && <Apilamiento idioma={idioma} pila={entidad.pila} />}
    </div>

    {
      facetas.length > 0 && (
        <ul class="mt-3 flex flex-wrap gap-1.5">
          {facetas.map((f) => (
            <li class="flex items-center gap-1.5 bloque bg-superficie-alta px-2.5 py-1 text-sm font-semibold">
              {COLOR_DIMENSION[f] && (
                <span
                  class="h-2.5 w-2.5 shrink-0"
                  style={`background:var(--etapa-${COLOR_DIMENSION[f]})`}
                  aria-hidden="true"
                />
              )}
              {ui(idioma, `faceta.${f}`)}
            </li>
          ))}
        </ul>
      )
    }

    {
      !texto.traducido && texto.idiomaUsado && (
        <p class="mt-4 bloque bg-superficie-alta px-3 py-2 text-sm">
          {ui(idioma, 'idioma.sinTraducir', {
            idioma: ui(idioma, `idioma.nombre.${texto.idiomaUsado}`)
          })}
        </p>
      )
    }

    {/* Ancho de lectura, no de parrafo estrecho. Con max-w-prose el texto se
        quedaba en 40 rem mientras las tablas de al lado ocupaban 72, y la
        ficha parecia cortada por la mitad. */}
    <p class="mt-5 max-w-4xl text-lg leading-relaxed">
      {texto.descripcion ?? ui(idioma, 'ficha.sinDescripcion')}
    </p>
  </header>

  {
    modulo === 'items' && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'obtencion.titulo')}</h2>
        {obtencion.length > 0 ? (
          <ul class="flex flex-wrap gap-2">
            {obtencion.map((m) => (
              <li class="bloque bg-superficie-alta px-3 py-2 font-semibold">
                {ui(idioma, `obtencion.${m}`)}
              </li>
            ))}
          </ul>
        ) : (
          <p class="text-texto-suave">{ui(idioma, 'obtencion.desconocido')}</p>
        )}
      </section>
    )
  }

  {/* Antes de nada: si esto no aparece solo sino que lo construyes tu, eso es
      lo primero que hay que saber, y va antes que la vida y el dano. */}
  {
    entidad.invocacion && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'mob.comoSeInvoca')}</h2>
        <Construccion idioma={idioma} invocacion={entidad.invocacion} />
      </section>
    )
  }

  {
    entidad.tipo === 'estructura' && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'estructura.porQueIr')}</h2>

        {exclusivo.length > 0 ? (
          <div class="bloque bg-superficie-alta p-4">
            <p class="mb-3 font-semibold">{ui(idioma, 'estructura.soloAqui')}</p>
            <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
              {exclusivo.map((otro) => (
                <li>
                  <TarjetaEntidad idioma={idioma} id={otro} compacto />
                </li>
              ))}
            </ul>
          </div>
        ) : (
          <p class="max-w-4xl text-texto-suave">{ui(idioma, 'estructura.nadaExclusivo')}</p>
        )}

        <ul class="mt-4 grid gap-2 sm:grid-cols-2">
          {entidad.comoSeEncuentra && (
            <li class="bloque p-3">
              <span class="block text-sm text-texto-suave">
                {ui(idioma, 'estructura.donde')}
              </span>
              <span class="font-bold">{ui(idioma, `faceta.${entidad.comoSeEncuentra}`)}</span>
            </li>
          )}
          {entidad.tieneGenerador && (
            <li class="bloque p-3">
              <span class="block text-sm text-texto-suave">
                {ui(idioma, 'estructura.generador')}
              </span>
              <span class="font-bold">{ui(idioma, 'estructura.generadorSi')}</span>
            </li>
          )}
        </ul>
      </section>
    )
  }

  {
    cuadriculas.length > 0 && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'rel.comoSeHace')}</h2>
        <div class="space-y-4">
          {cuadriculas.map((receta) => (
            <div class="bloque bg-superficie-alta p-4">
              <Cuadricula idioma={idioma} receta={receta} />
              <a
                href={rutaDe(idioma, receta.id)}
                class="mt-2 inline-block text-sm font-semibold hover:text-acento"
              >
                {ui(idioma, 'receta.verFicha')}
              </a>
            </div>
          ))}
        </div>
      </section>
    )
  }

  {
    cadenaPocion.length > 0 && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'pocion.comoSeHace')}</h2>
        <ol class="max-w-4xl space-y-2">
          {cadenaPocion.map((paso, i) => (
            <li class="flex flex-wrap items-center gap-x-2 gap-y-1 bloque p-3">
              <span class="grid h-6 w-6 shrink-0 place-items-center bg-acento-fondo text-xs font-extrabold text-acento-contraste">
                {i + 1}
              </span>
              <a href={enlace(paso.desde).url} class="font-semibold">
                {enlace(paso.desde).nombre}
              </a>
              <span class="text-texto-suave">+</span>
              {paso.ingrediente ? (
                <a href={enlace(paso.ingrediente).url} class="font-semibold">
                  {enlace(paso.ingrediente).nombre}
                </a>
              ) : (
                <span class="text-texto-suave">—</span>
              )}
              <span class="text-texto-suave" aria-hidden="true">
                →
              </span>
              <span class="font-bold">{enlace(paso.hasta).nombre}</span>
            </li>
          ))}
        </ol>
        <p class="mt-2 text-sm text-texto-suave">{ui(idioma, 'pocion.enElSoporte')}</p>
      </section>
    )
  }

  {
    datos.length > 0 && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'ficha.datos')}</h2>
        <ul class="grid grid-cols-2 gap-3 sm:grid-cols-4">
          {datos.map((d) => (
            <li class="bloque px-3 py-2.5">
              <span class="block text-xs font-semibold uppercase tracking-wide text-texto-suave">
                {d.etiqueta}
              </span>
              <span class="text-xl font-extrabold">{d.valor}</span>
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    entidad.tipo === 'receta' && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'ficha.receta')}</h2>
        <Cuadricula idioma={idioma} receta={entidad} />
      </section>
    )
  }

  {
    ingredientes?.length > 0 && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'rel.materiales')}</h2>
        <div class="tabla-envoltorio">
          <table>
            <thead>
              <tr>
                <th>{ui(idioma, 'tabla.objeto')}</th>
                <th>{ui(idioma, 'tabla.cantidad')}</th>
                <th>{ui(idioma, 'tabla.etapa')}</th>
              </tr>
            </thead>
            <tbody>
              {ingredientes.map((ing) => (
                <tr>
                  <td>
                    {ing.opciones.length === 1 ? (
                      <a href={enlace(ing.opciones[0]).url}>{enlace(ing.opciones[0]).nombre}</a>
                    ) : (
                      <span class="font-semibold">{etiquetaOpciones(ing.opciones)}</span>
                    )}
                  </td>
                  <td>{ing.cantidad}</td>
                  <td>
                    <Etapa idioma={idioma} etapa={grafo.get(ing.opciones[0]).entidad.etapa} />
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>

        {/* Las alternativas van plegadas: quien mira una receta quiere saber
            que necesita, no leer diecinueve maderas antes de llegar a ello. */}
        {ingredientes
          .filter((ing) => ing.opciones.length > 1)
          .map((ing) => (
            <details class="mt-3 bloque p-3">
              <summary class="cursor-pointer font-semibold">
                {ui(idioma, 'receta.verAlternativas', {
                  grupo: etiquetaOpciones(ing.opciones),
                  n: ing.opciones.length
                })}
              </summary>
              <ul class="mt-3 flex flex-wrap gap-2">
                {ing.opciones.map((o) => (
                  <li>
                    <a
                      href={enlace(o).url}
                      class="block bloque bloque-pulsable px-2.5 py-1 text-sm font-semibold"
                    >
                      {enlace(o).nombre}
                    </a>
                  </li>
                ))}
              </ul>
            </details>
          ))}
      </section>
    )
  }

  {
    entidad.niveles && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'ficha.tradeos')}</h2>
        {/* Una fila por trato, con el rango real que sortea el juego. Antes
            habia columnas sueltas de cantidad y no se entendia a que se
            referian; ahora la cantidad va pegada a su objeto. */}
        <div class="tabla-envoltorio">
          <table>
            <thead>
              <tr>
                <th>{ui(idioma, 'tabla.nivel')}</th>
                <th>{ui(idioma, 'tabla.tipoTrato')}</th>
                <th class="envuelve">{ui(idioma, 'tabla.leDas')}</th>
                <th class="envuelve">{ui(idioma, 'tabla.teDa')}</th>
                <th>{ui(idioma, 'tabla.usos')}</th>
              </tr>
            </thead>
            <tbody>
              {entidad.niveles.flatMap((nivel) =>
                nivel.tradeos.map((trato, i) => {
                  const daObjeto = trato.entrega.encantamiento ?? trato.entrega.item
                  return (
                    <tr>
                      {i === 0 && (
                        <td rowspan={nivel.tradeos.length}>
                          {ui(idioma, `aldeano.nivel.${nivel.nivel}`)}
                        </td>
                      )}
                      <td class="text-texto-suave">
                        {ui(idioma, `tabla.trato.${trato.tipo ?? 'venta'}`)}
                      </td>
                      <td class="envuelve">
                        {trato.recibe.map((r, j) => (
                          <>
                            {j > 0 && <span class="text-texto-suave"> + </span>}
                            <span class="font-semibold">{rango(r)}</span>{' '}
                            <a href={enlace(r.item).url}>{enlace(r.item).nombre}</a>
                            {r.variasOpciones && (
                              <span class="text-texto-suave"> {ui(idioma, 'tabla.oSimilares')}</span>
                            )}
                          </>
                        ))}
                      </td>
                      <td class="envuelve">
                        <span class="font-semibold">{trato.entrega.cantidad ?? 1}</span>{' '}
                        <a href={enlace(daObjeto).url}>{enlace(daObjeto).nombre}</a>
                        {trato.entrega.encantamiento && trato.entrega.nivelEncantamiento > 1 && (
                          <span> {trato.entrega.nivelEncantamiento}</span>
                        )}
                        {trato.entrega.encantamientoAleatorio && (
                          <span class="text-texto-suave"> {ui(idioma, 'tabla.encantadoAlAzar')}</span>
                        )}
                        {trato.entrega.variasOpciones && (
                          <span class="text-texto-suave"> {ui(idioma, 'tabla.oSimilares')}</span>
                        )}
                      </td>
                      <td class="text-texto-suave">{trato.usosMaximos ?? '—'}</td>
                    </tr>
                  )
                })
              )}
            </tbody>
          </table>
        </div>

        {/* Decirlo es mejor que dejar pensar que el aldeano solo tiene estos
            tratos, sobre todo cuando los niveles altos son los que compensan. */}
        {entidad.niveles.length === 1 && (
          <p class="mt-3 bloque bg-superficie-alta p-3 text-sm text-texto-suave">
            {ui(idioma, 'aldeano.soloNovato')}
          </p>
        )}
      </section>
    )
  }

  {
    // Solo en mobs: en biomas y estructuras "botin" es una lista de
    // referencias, no una tabla con cantidades, y la pintan las relaciones.
    entidad.tipo === 'mob' && entidad.botin?.length > 0 && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'ficha.botin')}</h2>
        <div class="tabla-envoltorio">
          <table>
            <thead>
              <tr>
                <th>{ui(idioma, 'tabla.objeto')}</th>
                <th>{ui(idioma, 'tabla.cantidad')}</th>
                <th>{ui(idioma, 'tabla.probabilidad')}</th>
                <th>{ui(idioma, 'tabla.condicion')}</th>
              </tr>
            </thead>
            <tbody>
              {entidad.botin.map((b) => (
                <tr>
                  <td>
                    <a href={enlace(b.item).url}>{enlace(b.item).nombre}</a>
                  </td>
                  <td>
                    {b.minimo === b.maximo ? b.maximo : `${b.minimo ?? 0} – ${b.maximo}`}
                  </td>
                  <td>{b.probabilidad ? `${Math.round(b.probabilidad * 100)} %` : '—'}</td>
                  <td class="text-texto-suave">
                    {b.soloAlMorirPorJugador ? ui(idioma, 'tabla.soloJugador') : '—'}
                  </td>
                </tr>
              ))}
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    entidad.tipo === 'pocion' && entidad.efecto !== 'ninguno' && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'pocion.mejorar')}</h2>
        <div class="tabla-envoltorio">
          <table>
            <thead>
              <tr>
                <th>{ui(idioma, 'pocion.quieres')}</th>
                <th>{ui(idioma, 'pocion.anades')}</th>
                <th>{ui(idioma, 'pocion.resultado')}</th>
              </tr>
            </thead>
            <tbody>
              {entidad.prolongada && (
                <tr>
                  <td>{ui(idioma, 'pocion.masDuracion')}</td>
                  <td>
                    <a href={enlace(entidad.prolongada.ingrediente).url}>
                      {enlace(entidad.prolongada.ingrediente).nombre}
                    </a>
                  </td>
                  <td>
                    {ui(idioma, 'ficha.minutos', {
                      n: Math.round(entidad.prolongada.duracionSegundos / 60)
                    })}
                  </td>
                </tr>
              )}
              {entidad.mejorada && (
                <tr>
                  <td>{ui(idioma, 'pocion.masPotencia')}</td>
                  <td>
                    <a href={enlace(entidad.mejorada.ingrediente).url}>
                      {enlace(entidad.mejorada.ingrediente).nombre}
                    </a>
                  </td>
                  <td>
                    {texto.nombre} II
                    {entidad.mejorada.duracionSegundos > 0 &&
                      ` · ${ui(idioma, 'ficha.minutos', { n: Math.round(entidad.mejorada.duracionSegundos / 60) })}`}
                  </td>
                </tr>
              )}
              {/* Estas dos valen para CUALQUIER pocion, asi que no se guardan
                  en los datos: repetirlas dieciseis veces seria mantenerlas
                  dieciseis veces. */}
              <tr>
                <td>{ui(idioma, 'pocion.arrojadiza')}</td>
                <td>
                  <a href={enlace('gunpowder').url}>{enlace('gunpowder').nombre}</a>
                </td>
                <td>{ui(idioma, 'pocion.arrojadizaResultado')}</td>
              </tr>
              <tr>
                <td>{ui(idioma, 'pocion.persistente')}</td>
                <td>
                  <a href={enlace('dragon_breath').url}>{enlace('dragon_breath').nombre}</a>
                </td>
                <td>{ui(idioma, 'pocion.persistenteResultado')}</td>
              </tr>
            </tbody>
          </table>
        </div>
      </section>
    )
  }

  {
    entidad.debilidades?.length > 0 && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'ficha.leVaMal')}</h2>
        <ul class="flex flex-wrap gap-2">
          {entidad.debilidades.map((d) => (
            <li class="bloque bg-superficie-alta px-3 py-1.5 text-sm font-semibold">
              {ui(idioma, `debilidad.${d}`)}
            </li>
          ))}
        </ul>
      </section>
    )
  }

  {
    texto.pasos?.length > 0 && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'ficha.pasos')}</h2>
        <ol class="max-w-4xl space-y-2">
          {texto.pasos.map((paso, i) => (
            <li class="flex gap-3 bloque p-3">
              <span class="grid h-7 w-7 shrink-0 place-items-center bg-acento-fondo text-sm font-extrabold text-acento-contraste">
                {i + 1}
              </span>
              <span>{paso}</span>
            </li>
          ))}
        </ol>
      </section>
    )
  }

  {
    consejos.length > 0 && (
      <section class="mb-10">
        <h2 class="titulo-seccion">{ui(idioma, 'ficha.consejos')}</h2>
        {/* Dos columnas solo si hay dos cosas que contar. Con una sola, media
            pantalla se quedaba vacia al lado. */}
        <div class:list={['grid gap-3', consejos.length > 1 && 'lg:grid-cols-2']}>
          {consejos.map((c) => (
            <p class="bloque bg-superficie-alta p-3">{c}</p>
          ))}
        </div>
      </section>
    )
  }

  {
    texto.advertencia && (
      <p class="mb-10 flex gap-2 border-l-2 border-l-[var(--etapa-nether)] pl-3 text-sm text-texto-suave">
        <span aria-hidden="true">⚠</span>
        <span>{texto.advertencia}</span>
      </p>
    )
  }

  {/* Aqui esta el valor real de la wiki: todo lo conectado, ya resuelto, para
      que nadie tenga que volver al buscador.

      La cabecera de este bloque tiene que pesar mas que la de cada grupo de
      dentro. Antes era al reves: los grupos llevaban la barra de color de las
      secciones y el titulo que los agrupa iba suelto, asi que los hijos
      parecian mas importantes que el padre. */}
  {
    grupos.length > 0 && (
      <section class="mt-12 border-t-4 border-acento pt-6">
        <h2 class="text-3xl font-extrabold">{ui(idioma, 'ficha.relacionado')}</h2>
        <p class="mt-1 mb-8 text-texto-suave">{ui(idioma, 'ficha.relacionadoExplicacion')}</p>

        {grupos.map((grupo) => (
          <div class="mb-7">
            <h3 class="mb-2 flex items-baseline gap-2 text-sm font-bold tracking-wide text-texto-suave uppercase">
              {ui(idioma, grupo.etiqueta)}
              <span class="text-xs font-semibold normal-case">{grupo.ids.length}</span>
            </h3>
            <ul class="grid grid-cols-2 gap-2 sm:grid-cols-3 lg:grid-cols-4 xl:grid-cols-6">
              {grupo.ids.map((otro) => (
                <li>
                  <TarjetaEntidad idioma={idioma} id={otro} compacto={true} />
                </li>
              ))}
            </ul>
          </div>
        ))}
      </section>
    )
  }

  {
    parecidos.length > 0 && (
      <section class="mt-4 border-t-2 border-borde pt-6">
        <h2 class="mb-3 text-base font-bold text-texto-suave">{ui(idioma, 'ficha.parecidos')}</h2>
        <ul class="flex flex-wrap gap-2">
          {parecidos.map((otro) => (
            <li>
              <a
                href={rutaDe(idioma, otro)}
                class="block bloque bloque-pulsable px-3 py-1.5 text-sm font-semibold"
              >
                {t(idioma, otro).nombre}
              </a>
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
