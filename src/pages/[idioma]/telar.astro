---
/**
 * Disenador de estandartes.
 *
 * Eliges tela, tinte y dibujo, y ves el estandarte crecer capa a capa. Lo que
 * importa no es el dibujo, que eso lo hace el telar del juego: es lo que hay
 * debajo, la lista de lo que tienes que llevar y los pasos en orden. Es lo que
 * nadie recuerda al llegar al telar con tres tintes de menos.
 *
 * Sin JavaScript la pagina sigue sirviendo: trae una idea ya montada con sus
 * materiales y sus pasos, y la lista de los dibujos que piden un patron.
 */
import Base from '../../layouts/Base.astro'
import SpriteTelar from '../../components/SpriteTelar.astro'
import Icono from '../../components/Icono.astro'
import { codigosIdioma, ui, t, rutaDe, RUTA_TINTES } from '../../lib/datos.js'
import {
  COLORES,
  HEX,
  PATRONES,
  IDEAS,
  IDEA_INICIAL,
  MAX_CAPAS,
  ANCHO,
  ALTO,
  tinte,
  svgEstandarte,
  svgEscudo,
  svgTinte,
  htmlMateriales,
  htmlPasos,
  aTextoDiseno
} from '../../lib/tintes.js'
import { textosTelar } from '../../lib/tintes-datos.js'

export function getStaticPaths() {
  return codigosIdioma.map((idioma) => ({ params: { idioma } }))
}

const { idioma } = Astro.params
const T = textosTelar(idioma)
const inicial = IDEA_INICIAL
const conItem = PATRONES.filter((p) => p.item)
---

<Base idioma={idioma} titulo={ui(idioma, 'telar.titulo')} descripcion={ui(idioma, 'telar.subtitulo')}>
  <SpriteTelar />

  <header class="mb-8 border-b-2 border-borde pb-5">
    <h1 class="text-4xl sm:text-5xl">{ui(idioma, 'telar.titulo')}</h1>
    <p class="mt-4 max-w-4xl text-lg leading-relaxed">{ui(idioma, 'telar.subtitulo')}</p>
  </header>

  <div
    data-telar
    class="mb-10 grid grid-cols-1 gap-6 lg:grid-cols-[18rem_minmax(0,1fr)]"
    style={`--telar-base:${HEX[inicial.base]};--telar-tinte:${HEX.black}`}
  >
    {/* La vista se queda quieta al bajar: es lo que estas mirando mientras
        eliges, y perderla de vista al llegar a los dibujos era justo el fallo. */}
    <div class="lg:sticky lg:top-36 lg:self-start">
      <div class="bandeja flex items-end justify-center gap-4 py-5">
        <div data-vista set:html={svgEstandarte(inicial, { clase: 'h-72 w-auto', titulo: ui(idioma, 'telar.vista') })} />
        <div class="text-center">
          <div data-escudo set:html={svgEscudo(inicial, { clase: 'h-24 w-auto', titulo: ui(idioma, 'telar.enEscudo') })} />
          <span class="mt-1 block text-xs text-texto-suave">{ui(idioma, 'telar.enEscudo')}</span>
        </div>
      </div>

      <p class="mt-3 text-center text-sm font-bold" data-contador>
        {ui(idioma, 'telar.capas', { n: inicial.capas.length, max: MAX_CAPAS })}
      </p>

      <ol data-capas class="mt-2 space-y-1.5"></ol>

      <div class="mt-3 flex flex-wrap justify-center gap-1.5">
        <button type="button" data-deshacer class="bloque bloque-pulsable px-3 py-1.5 text-sm font-semibold">
          {ui(idioma, 'telar.deshacer')}
        </button>
        <button type="button" data-vaciar class="bloque bloque-pulsable px-3 py-1.5 text-sm font-semibold">
          {ui(idioma, 'telar.vaciar')}
        </button>
        <button
          type="button"
          data-compartir
          class="bloque bloque-pulsable bg-acento-fondo px-3 py-1.5 text-sm font-bold text-acento-contraste"
        >
          {ui(idioma, 'telar.compartir')}
        </button>
      </div>
    </div>

    <div class="min-w-0">
      <section class="mb-6">
        <h2 class="titulo-seccion">{ui(idioma, 'telar.paso1')}</h2>
        <div class="flex flex-wrap gap-1.5" role="group" aria-label={ui(idioma, 'telar.paso1')}>
          {
            COLORES.map((c) => (
              <button
                type="button"
                data-base={c.id}
                aria-pressed={c.id === inicial.base ? 'true' : 'false'}
                title={t(idioma, `${c.id}_banner`).nombre}
                aria-label={t(idioma, `${c.id}_banner`).nombre}
                class="grid h-11 w-11 place-items-center hueco aria-pressed:border-acento aria-pressed:shadow-[0_0_0_2px_var(--acento)]"
              >
                <span class="block h-7 w-5" style={`background:${c.hex}`} />
              </button>
            ))
          }
        </div>
      </section>

      <section class="mb-6">
        <h2 class="titulo-seccion">{ui(idioma, 'telar.paso2')}</h2>
        <div class="flex flex-wrap gap-1.5" role="group" aria-label={ui(idioma, 'telar.paso2')}>
          {
            COLORES.map((c) => (
              <button
                type="button"
                data-tinte={c.id}
                aria-pressed={c.id === 'black' ? 'true' : 'false'}
                title={t(idioma, tinte(c.id)).nombre}
                aria-label={t(idioma, tinte(c.id)).nombre}
                class="grid h-11 w-11 place-items-center hueco aria-pressed:border-acento aria-pressed:shadow-[0_0_0_2px_var(--acento)]"
                set:html={svgTinte(c.id, 'h-8 w-8')}
              />
            ))
          }
        </div>
      </section>

      <section>
        <h2 class="titulo-seccion">{ui(idioma, 'telar.paso3')}</h2>
        <p class="mb-3 text-sm text-texto-suave">{ui(idioma, 'telar.paso3Ayuda')}</p>
        {/* Cada dibujo se ensena ya con la tela y el tinte elegidos: lo que ves
            en el boton es lo que vas a anadir. Lo cambian dos variables de CSS,
            sin tocar ninguno de los cuarenta y tantos botones. */}
        <ul class="grid grid-cols-[repeat(auto-fill,minmax(3.25rem,1fr))] gap-1.5">
          {
            PATRONES.map((p) => (
              <li>
                <button
                  type="button"
                  data-patron={p.id}
                  title={ui(idioma, `telar.patron.${p.id}`)}
                  aria-label={ui(idioma, `telar.patron.${p.id}`)}
                  class="relative grid w-full place-items-center hueco p-1 disabled:opacity-40"
                >
                  <svg viewBox={`0 0 ${ANCHO} ${ALTO}`} class="h-14 w-7" shape-rendering="crispEdges" aria-hidden="true">
                    <rect width={ANCHO} height={ALTO} fill="var(--telar-base)" />
                    <use href={`#pt-${p.id}`} width={ANCHO} height={ALTO} style="color:var(--telar-tinte)" />
                  </svg>
                  {p.item && (
                    <span
                      class="absolute top-0.5 right-0.5 grid h-4 w-4 place-items-center bloque bg-acento-fondo text-acento-contraste"
                      title={t(idioma, p.item).nombre}
                    >
                      <Icono modulo="telar" clase="h-3 w-3" />
                    </span>
                  )}
                </button>
              </li>
            ))
          }
        </ul>
        <p class="mt-2 flex items-center gap-2 text-sm text-texto-suave">
          <span class="grid h-4 w-4 place-items-center bloque bg-acento-fondo text-acento-contraste">
            <Icono modulo="telar" clase="h-3 w-3" />
          </span>
          {ui(idioma, 'telar.leyendaItem')}
        </p>
      </section>
    </div>
  </div>

  <section class="mb-10">
    <h2 class="titulo-seccion">{ui(idioma, 'telar.ideas')}</h2>
    {/* Son enlaces y no botones: el diseno vive en la direccion, asi que cada
        idea se puede abrir en otra pestana o mandar a un amigo. */}
    <ul class="grid grid-cols-3 gap-2 sm:grid-cols-6">
      {
        IDEAS.map((idea) => (
          <li>
            <a
              href={`#${aTextoDiseno(idea)}`}
              data-idea
              class="flex h-full flex-col items-center gap-2 bloque bloque-pulsable p-3 text-center"
            >
              <span set:html={svgEstandarte(idea, { clase: 'h-24 w-auto' })} />
              <span class="text-sm font-semibold">{ui(idioma, `telar.idea.${idea.id}`)}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <div class="mb-10 grid gap-6 md:grid-cols-2">
    <section>
      <h2 class="titulo-seccion">{ui(idioma, 'telar.necesitas')}</h2>
      <div data-materiales class="bloque bg-superficie-alta p-4" set:html={htmlMateriales(inicial, T)} />
    </section>
    <section>
      <h2 class="titulo-seccion">{ui(idioma, 'telar.pasos')}</h2>
      <div class="bloque bg-superficie-alta p-4">
        <div data-pasos set:html={htmlPasos(inicial, T)} />
        <p class="mt-4 border-t-2 border-borde pt-3 text-sm text-texto-suave">
          {ui(idioma, 'telar.entreCapas')}
        </p>
      </div>
    </section>
  </div>

  <section class="mb-10">
    <h2 class="titulo-seccion">{ui(idioma, 'telar.trucos')}</h2>
    <ul class="grid gap-3 md:grid-cols-2">
      {
        ['escudo', 'copiar', 'quitar', 'limite'].map((truco) => (
          <li class="bloque bg-superficie-alta p-4">
            <h3 class="titulo text-xl">{ui(idioma, `telar.truco.${truco}`)}</h3>
            <p class="mt-1">{ui(idioma, `telar.truco.${truco}Texto`)}</p>
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-10">
    <h2 class="titulo-seccion">{ui(idioma, 'telar.conPatron')}</h2>
    <p class="mb-3 max-w-4xl">{ui(idioma, 'telar.conPatronTexto')}</p>
    <ul class="grid grid-cols-1 gap-2 sm:grid-cols-2 lg:grid-cols-3">
      {
        conItem.map((p) => (
          <li>
            <a
              href={rutaDe(idioma, p.item)}
              class="flex items-center gap-3 bloque bloque-pulsable p-2"
            >
              <span
                class="shrink-0"
                set:html={svgEstandarte(
                  { base: 'white', capas: [{ patron: p.id, color: 'black' }] },
                  { clase: 'h-14 w-auto' }
                )}
              />
              <span class="min-w-0">
                <span class="block font-semibold">{ui(idioma, `telar.patron.${p.id}`)}</span>
                <span class="block text-sm text-texto-suave">{t(idioma, p.item).nombre}</span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  <a
    href={`/${idioma}/${RUTA_TINTES}/`}
    class="flex flex-wrap items-center gap-x-4 gap-y-2 bloque bloque-pulsable bg-superficie-alta p-4"
  >
    <span class="grid h-12 w-12 shrink-0 place-items-center bloque bg-superficie">
      <Icono modulo="tintes" clase="h-7 w-7 text-acento" />
    </span>
    <span class="min-w-0 flex-1">
      <span class="titulo block text-xl">{ui(idioma, 'tintes.titulo')}</span>
      <span class="mt-0.5 block text-sm text-texto-suave">{ui(idioma, 'telar.faltaTinte')}</span>
    </span>
  </a>

  <script type="application/json" data-textos-telar set:html={JSON.stringify(T)} />
</Base>

<script>
  import {
    HEX,
    MAX_CAPAS,
    IDEA_INICIAL,
    ANCHO,
    ALTO,
    svgEstandarte,
    svgEscudo,
    htmlMateriales,
    htmlPasos,
    aTextoDiseno,
    deTextoDiseno
  } from '../../lib/tintes.js'

  const raiz = document.querySelector('[data-telar]')
  const fuenteTextos = document.querySelector('[data-textos-telar]')

  if (raiz && fuenteTextos) {
    const T = JSON.parse(fuenteTextos.textContent)
    const $ = (sel) => document.querySelector(sel)
    const $$ = (sel) => [...document.querySelectorAll(sel)]

    const vista = $('[data-vista]')
    const escudo = $('[data-escudo]')
    const contador = $('[data-contador]')
    const listaCapas = $('[data-capas]')
    const listaMateriales = $('[data-materiales]')
    const listaPasos = $('[data-pasos]')

    let diseno = deTextoDiseno(location.hash) ?? structuredClone(IDEA_INICIAL)
    let tinteElegido = 'black'

    const marcar = (selector, atributo, valor) => {
      for (const b of $$(selector)) b.setAttribute('aria-pressed', String(b.dataset[atributo] === valor))
    }

    const htmlCapa = (capa, i) => {
      const nombre = T.patron[capa.patron]
      const tinte = T.nombre[`${capa.color}_dye`]
      const boton = (accion, texto, simbolo, deshabilitado) =>
        `<button type="button" data-accion="${accion}" data-i="${i}" title="${texto}" aria-label="${texto}" ${
          deshabilitado ? 'disabled' : ''
        } class="grid h-7 w-7 place-items-center bloque bloque-pulsable text-sm font-bold disabled:opacity-30">${simbolo}</button>`
      return (
        `<li class="flex items-center gap-2 bloque bg-superficie-alta p-1.5">` +
        `<svg viewBox="0 0 ${ANCHO} ${ALTO}" class="h-8 w-4 shrink-0" aria-hidden="true"><rect width="${ANCHO}" height="${ALTO}" fill="${HEX[diseno.base]}"/><use href="#pt-${capa.patron}" width="${ANCHO}" height="${ALTO}" style="color:${HEX[capa.color]}"/></svg>` +
        `<span class="min-w-0 flex-1 text-sm leading-tight"><span class="block font-semibold">${i + 1}. ${nombre}</span><span class="block text-texto-suave">${tinte}</span></span>` +
        boton('subir', T.ui.subir, '↑', i === 0) +
        boton('bajar', T.ui.bajar, '↓', i === diseno.capas.length - 1) +
        boton('quitar', T.ui.quitar, '✕', false) +
        `</li>`
      )
    }

    const pintar = ({ guardar = true } = {}) => {
      raiz.style.setProperty('--telar-base', HEX[diseno.base])
      raiz.style.setProperty('--telar-tinte', HEX[tinteElegido])
      marcar('[data-base]', 'base', diseno.base)
      marcar('[data-tinte]', 'tinte', tinteElegido)

      vista.innerHTML = svgEstandarte(diseno, {
        clase: 'h-72 w-auto',
        titulo: vista.firstElementChild?.getAttribute('aria-label') ?? ''
      })
      escudo.innerHTML = svgEscudo(diseno, {
        clase: 'h-24 w-auto',
        titulo: escudo.firstElementChild?.getAttribute('aria-label') ?? ''
      })

      const lleno = diseno.capas.length >= MAX_CAPAS
      contador.textContent = lleno
        ? T.ui.lleno
        : T.ui.capas.replace('{n}', diseno.capas.length).replace('{max}', MAX_CAPAS)
      contador.classList.toggle('text-[var(--etapa-nether)]', lleno)
      for (const b of $$('[data-patron]')) b.disabled = lleno

      listaCapas.innerHTML = diseno.capas.map(htmlCapa).join('')
      listaMateriales.innerHTML = htmlMateriales(diseno, T)
      listaPasos.innerHTML = htmlPasos(diseno, T)

      // replaceState y no location.hash: cada clic no debe ser un paso mas en
      // el boton de atras del navegador.
      if (guardar) history.replaceState(null, '', `#${aTextoDiseno(diseno)}`)
    }

    for (const b of $$('[data-base]')) {
      b.addEventListener('click', () => {
        diseno.base = b.dataset.base
        pintar()
      })
    }
    for (const b of $$('[data-tinte]')) {
      b.addEventListener('click', () => {
        tinteElegido = b.dataset.tinte
        pintar()
      })
    }
    for (const b of $$('[data-patron]')) {
      b.addEventListener('click', () => {
        if (diseno.capas.length >= MAX_CAPAS) return
        diseno.capas.push({ patron: b.dataset.patron, color: tinteElegido })
        pintar()
      })
    }

    listaCapas.addEventListener('click', (evento) => {
      const b = evento.target.closest('[data-accion]')
      if (!b) return
      const i = Number(b.dataset.i)
      const capas = diseno.capas
      if (b.dataset.accion === 'quitar') capas.splice(i, 1)
      if (b.dataset.accion === 'subir' && i > 0) [capas[i - 1], capas[i]] = [capas[i], capas[i - 1]]
      if (b.dataset.accion === 'bajar' && i < capas.length - 1)
        [capas[i + 1], capas[i]] = [capas[i], capas[i + 1]]
      pintar()
    })

    $('[data-deshacer]').addEventListener('click', () => {
      diseno.capas.pop()
      pintar()
    })
    $('[data-vaciar]').addEventListener('click', () => {
      diseno.capas = []
      pintar()
    })

    $('[data-compartir]').addEventListener('click', async (evento) => {
      const boton = evento.currentTarget
      const url = `${location.origin}${location.pathname}#${aTextoDiseno(diseno)}`
      try {
        await navigator.clipboard.writeText(url)
      } catch {
        const auxiliar = document.createElement('textarea')
        auxiliar.value = url
        document.body.append(auxiliar)
        auxiliar.select()
        document.execCommand('copy')
        auxiliar.remove()
      }
      const antes = boton.textContent
      boton.textContent = T.ui.copiado
      setTimeout(() => (boton.textContent = antes), 1200)
    })

    // Las ideas son enlaces con el diseno en la direccion. Al pulsar una cambia
    // el hash, y desde aqui se recoge; se sube a la vista para ver el cambio.
    addEventListener('hashchange', () => {
      const nuevo = deTextoDiseno(location.hash)
      if (!nuevo) return
      diseno = nuevo
      pintar({ guardar: false })
    })
    for (const a of $$('[data-idea]')) {
      a.addEventListener('click', () => {
        requestAnimationFrame(() => raiz.scrollIntoView({ behavior: 'smooth', block: 'start' }))
      })
    }

    pintar({ guardar: Boolean(location.hash) })
  }
</script>
