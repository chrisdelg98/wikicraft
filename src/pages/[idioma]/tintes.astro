---
/**
 * Mezclador de tintes.
 *
 * Arriba, el juego: pones tintes en la cuadricula del inventario y ves que
 * sale, o que te falta para que salga algo. Abajo, la respuesta sin juego para
 * quien llega con la pregunta hecha ("como saco el rosa"): los dieciseis
 * tintes, cada uno con de donde sale y con que se mezcla.
 *
 * Todo sale de las recetas del grafo (ver src/lib/tintes-datos.js). Sin
 * JavaScript se pierde el mezclador y se queda lo de abajo, que es lo que
 * contesta la pregunta.
 */
import Base from '../../layouts/Base.astro'
import SpriteTelar from '../../components/SpriteTelar.astro'
import Icono from '../../components/Icono.astro'
import { codigosIdioma, ui, t, rutaDe, RUTA_TELAR } from '../../lib/datos.js'
import { COLORES, tinte, svgTinte, claveMezcla } from '../../lib/tintes.js'
import { mezclas, fuentes } from '../../lib/tintes-datos.js'

export function getStaticPaths() {
  return codigosIdioma.map((idioma) => ({ params: { idioma } }))
}

const { idioma } = Astro.params

const nombre = (id) => t(idioma, id).nombre
const LADO = 4 // la cuadricula de 2x2 del inventario; ninguna mezcla pasa de cuatro

// Empieza con una mezcla puesta, para que sin tocar nada ya se entienda que
// hace: azul y blanco dan azul claro.
const INICIAL = ['blue', 'white']
const resultadoInicial = mezclas.find((m) => m.clave === claveMezcla(INICIAL))

const tarjetas = COLORES.map(({ id: color }) => ({
  color,
  id: tinte(color),
  fabricando: fuentes[color].fabricando,
  fundiendo: fuentes[color].fundiendo,
  mezclas: mezclas.filter((m) => m.color === color),
  sirvePara: [...new Set(mezclas.filter((m) => m.colores.includes(color)).map((m) => m.color))]
}))

/** Lo que el mezclador necesita en el navegador, y nada mas. */
const paraElNavegador = {
  mezclas: mezclas.map(({ color, cantidad, colores, clave }) => ({ color, cantidad, colores, clave })),
  nombre: Object.fromEntries(COLORES.map((c) => [c.id, nombre(tinte(c.id))])),
  url: Object.fromEntries(COLORES.map((c) => [c.id, rutaDe(idioma, tinte(c.id))])),
  ui: Object.fromEntries(
    ['vacio', 'nada', 'falta', 'quitar', 'lleno', 'sale'].map((k) => [k, ui(idioma, `tintes.${k}`)])
  )
}

const lista = (ids) =>
  ids.map((id, i) => ({ id, url: rutaDe(idioma, id), nombre: nombre(id), coma: i < ids.length - 1 }))
---

<Base idioma={idioma} titulo={ui(idioma, 'tintes.titulo')} descripcion={ui(idioma, 'tintes.subtitulo')}>
  <SpriteTelar conPatrones={false} />

  <header class="mb-8 border-b-2 border-borde pb-5">
    <h1 class="text-4xl sm:text-5xl">{ui(idioma, 'tintes.titulo')}</h1>
    <p class="mt-4 max-w-4xl text-lg leading-relaxed">{ui(idioma, 'tintes.subtitulo')}</p>
  </header>

  <section class="mb-12" data-mezclador>
    <h2 class="titulo-seccion">{ui(idioma, 'tintes.prueba')}</h2>
    <p class="mb-3 text-texto-suave">{ui(idioma, 'tintes.pruebaAyuda')}</p>

    <div class="grid grid-cols-1 gap-6 lg:grid-cols-[minmax(0,1fr)_auto]">
      <div class="flex flex-wrap content-start gap-1.5" role="group" aria-label={ui(idioma, 'tintes.paleta')}>
        {
          COLORES.map((c) => (
            <button
              type="button"
              data-poner={c.id}
              title={nombre(tinte(c.id))}
              aria-label={nombre(tinte(c.id))}
              class="grid h-14 w-14 place-items-center hueco"
              set:html={svgTinte(c.id, 'h-10 w-10')}
            />
          ))
        }
      </div>

      {/* La cuadricula de 2x2 del inventario, con su flecha y su resultado: la
          forma ya dice que esto se hace sin mesa de trabajo. */}
      <div class="bandeja flex flex-wrap items-center gap-3 self-start p-3">
        <div class="grid grid-cols-2 gap-1" data-mesa>
          {
            Array.from({ length: LADO }, (_, i) => (
              <button
                type="button"
                data-hueco={i}
                class:list={[
                  'grid h-16 w-16 place-items-center hueco',
                  !INICIAL[i] && 'hueco-vacio'
                ]}
                aria-label={INICIAL[i] ? `${ui(idioma, 'tintes.quitar')}: ${nombre(tinte(INICIAL[i]))}` : ''}
                set:html={INICIAL[i] ? svgTinte(INICIAL[i], 'h-11 w-11') : ''}
              />
            ))
          }
        </div>
        <svg viewBox="0 0 16 16" class="h-8 w-8 text-texto-suave" fill="currentColor" aria-hidden="true">
          <path d="M2 6h7V3l5 5-5 5v-3H2z" />
        </svg>
        <div
          data-resultado
          class="relative grid h-20 w-20 place-items-center hueco"
          set:html={resultadoInicial
            ? `${svgTinte(resultadoInicial.color, 'h-14 w-14')}<span class="absolute right-1 bottom-0.5 text-lg font-bold">${resultadoInicial.cantidad}</span>`
            : ''}
        />
        <button
          type="button"
          data-vaciar
          class="bloque bloque-pulsable px-3 py-1.5 text-sm font-semibold"
        >
          {ui(idioma, 'tintes.vaciar')}
        </button>
      </div>
    </div>

    <div data-mensaje class="mt-4 bloque bg-superficie-alta p-4 text-lg" aria-live="polite">
      {
        resultadoInicial && (
          <Fragment
            set:html={ui(idioma, 'tintes.sale', {
              n: String(resultadoInicial.cantidad),
              tinte: `<a href="${rutaDe(idioma, tinte(resultadoInicial.color))}" class="font-bold underline decoration-borde-fuerte underline-offset-2 hover:text-acento">${nombre(tinte(resultadoInicial.color))}</a>`
            })}
          />
        )
      }
    </div>
    <ul data-pistas class="mt-2 space-y-1.5"></ul>
  </section>

  <section class="mb-12">
    <h2 class="titulo-seccion">{ui(idioma, 'tintes.todos')}</h2>
    <p class="mb-4 max-w-4xl">{ui(idioma, 'tintes.todosAyuda')}</p>
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        tarjetas.map((tj) => (
          <li class="flex flex-col gap-2 bloque bg-superficie-alta p-4" id={tj.color}>
            <a href={rutaDe(idioma, tj.id)} class="flex items-center gap-3 hover:text-acento">
              <span class="grid h-12 w-12 shrink-0 place-items-center hueco" set:html={svgTinte(tj.color, 'h-9 w-9')} />
              <span class="titulo text-2xl">{nombre(tj.id)}</span>
            </a>

            {(tj.fabricando.length > 0 || tj.fundiendo.length > 0) && (
              <p class="text-sm">
                <span class="font-bold">{ui(idioma, 'tintes.saleDe')}</span>{' '}
                {lista(tj.fabricando).map((x) => (
                  <>
                    <a href={x.url} class="underline decoration-borde-fuerte underline-offset-2 hover:text-acento">{x.nombre}</a>
                    {x.coma && ', '}
                  </>
                ))}
                {tj.fundiendo.length > 0 && (
                  <>
                    {tj.fabricando.length > 0 && '; '}
                    {ui(idioma, 'tintes.enHorno')}{' '}
                    {lista(tj.fundiendo).map((x) => (
                      <>
                        <a href={x.url} class="underline decoration-borde-fuerte underline-offset-2 hover:text-acento">{x.nombre}</a>
                        {x.coma && ', '}
                      </>
                    ))}
                  </>
                )}
              </p>
            )}

            {tj.mezclas.length > 0 && (
              <div>
                <p class="text-sm font-bold">{ui(idioma, 'tintes.mezclando')}</p>
                <ul class="mt-1 space-y-1">
                  {tj.mezclas.map((m) => (
                    <li class="flex flex-wrap items-center gap-1" aria-label={`${m.colores.map((c) => nombre(tinte(c))).join(' + ')} = ${m.cantidad} × ${nombre(tj.id)}`}>
                      {m.colores.map((c, i) => (
                        <>
                          {i > 0 && <span class="font-bold text-texto-suave" aria-hidden="true">+</span>}
                          <span title={nombre(tinte(c))} set:html={svgTinte(c, 'h-7 w-7')} />
                        </>
                      ))}
                      <span class="font-bold text-texto-suave" aria-hidden="true">=</span>
                      <span class="font-bold" aria-hidden="true">{m.cantidad}×</span>
                      <span set:html={svgTinte(tj.color, 'h-7 w-7')} />
                    </li>
                  ))}
                </ul>
              </div>
            )}

            {tj.sirvePara.length > 0 && (
              <p class="mt-auto text-sm text-texto-suave">
                {ui(idioma, 'tintes.sirvePara')}{' '}
                {tj.sirvePara.map((c, i) => (
                  <>
                    <a href={`#${c}`} class="hover:text-acento">{nombre(tinte(c))}</a>
                    {i < tj.sirvePara.length - 1 && ', '}
                  </>
                ))}
              </p>
            )}
          </li>
        ))
      }
    </ul>
  </section>

  <section class="mb-10 bloque bg-superficie-alta p-4">
    <h2 class="titulo-seccion">{ui(idioma, 'tintes.paraQue')}</h2>
    <p class="max-w-4xl">{ui(idioma, 'tintes.paraQueTexto')}</p>
  </section>

  <a
    href={`/${idioma}/${RUTA_TELAR}/`}
    class="flex flex-wrap items-center gap-x-4 gap-y-2 bloque bloque-pulsable bg-superficie-alta p-4"
  >
    <span class="grid h-12 w-12 shrink-0 place-items-center bloque bg-superficie">
      <Icono modulo="telar" clase="h-7 w-7 text-acento" />
    </span>
    <span class="min-w-0 flex-1">
      <span class="titulo block text-xl">{ui(idioma, 'telar.titulo')}</span>
      <span class="mt-0.5 block text-sm text-texto-suave">{ui(idioma, 'telar.subtitulo')}</span>
    </span>
    <span class="shrink-0 bloque bg-acento-fondo px-3 py-1.5 text-sm font-bold text-acento-contraste">
      {ui(idioma, 'telar.abrir')}
    </span>
  </a>

  <script type="application/json" data-textos-tintes set:html={JSON.stringify({ ...paraElNavegador, inicial: INICIAL })} />
</Base>

<script>
  import { svgTinte, claveMezcla } from '../../lib/tintes.js'

  const raiz = document.querySelector('[data-mezclador]')
  const fuente = document.querySelector('[data-textos-tintes]')

  if (raiz && fuente) {
    const D = JSON.parse(fuente.textContent)
    const huecos = [...raiz.querySelectorAll('[data-hueco]')]
    const resultado = raiz.querySelector('[data-resultado]')
    const mensaje = raiz.querySelector('[data-mensaje]')
    const pistas = raiz.querySelector('[data-pistas]')
    const LADO = huecos.length

    let mesa = [...D.inicial]

    const enlace = (color) =>
      `<a href="${D.url[color]}" class="font-bold underline decoration-borde-fuerte underline-offset-2 hover:text-acento">${D.nombre[color]}</a>`
    const rellenar = (plantilla, valores) =>
      Object.entries(valores).reduce((t, [k, v]) => t.replaceAll(`{${k}}`, v), plantilla)

    /** Lo que le falta a la mesa para ser cada mezcla, si le falta poco. */
    const faltaPara = (m) => {
      const resto = [...m.colores]
      for (const c of mesa) {
        const i = resto.indexOf(c)
        if (i < 0) return null
        resto.splice(i, 1)
      }
      return resto.length > 0 && mesa.length + resto.length <= LADO ? resto : null
    }

    const pintar = () => {
      huecos.forEach((h, i) => {
        const color = mesa[i]
        h.innerHTML = color ? svgTinte(color, 'h-11 w-11') : ''
        h.classList.toggle('hueco-vacio', !color)
        h.setAttribute('aria-label', color ? `${D.ui.quitar}: ${D.nombre[color]}` : '')
      })

      const mezcla = D.mezclas.find((m) => m.clave === claveMezcla(mesa))
      resultado.innerHTML = mezcla
        ? `${svgTinte(mezcla.color, 'h-14 w-14')}<span class="absolute right-1 bottom-0.5 text-lg font-bold">${mezcla.cantidad}</span>`
        : ''

      if (mesa.length === 0) mensaje.textContent = D.ui.vacio
      else if (mezcla)
        mensaje.innerHTML = rellenar(D.ui.sale, { n: mezcla.cantidad, tinte: enlace(mezcla.color) })
      else mensaje.textContent = mesa.length >= LADO ? D.ui.lleno : D.ui.nada

      // Con algo puesto y sin resultado (o con resultado y sitio libre), lo
      // util es decir que te falta. Es la pregunta que viene despues.
      const cercanas = mesa.length === 0 ? [] : D.mezclas
        .map((m) => ({ m, falta: faltaPara(m) }))
        .filter((x) => x.falta)
      pistas.innerHTML = cercanas
        .map(
          ({ m, falta }) =>
            `<li class="flex flex-wrap items-center gap-2 bloque bg-superficie p-2 text-sm">` +
            falta.map((c) => svgTinte(c, 'h-6 w-6')).join('') +
            `<span>${rellenar(D.ui.falta, {
              // "2 × Tinte rojo" y no "Tinte rojo + Tinte rojo".
              faltan: [...new Set(falta)]
                .map((c) => {
                  const n = falta.filter((x) => x === c).length
                  return n > 1 ? `${n} × ${D.nombre[c]}` : D.nombre[c]
                })
                .join(' + '),
              n: m.cantidad,
              tinte: enlace(m.color)
            })}</span></li>`
        )
        .join('')
    }

    for (const b of raiz.querySelectorAll('[data-poner]')) {
      b.addEventListener('click', () => {
        if (mesa.length >= LADO) return
        mesa.push(b.dataset.poner)
        pintar()
      })
    }
    huecos.forEach((h, i) =>
      h.addEventListener('click', () => {
        if (!mesa[i]) return
        mesa.splice(i, 1)
        pintar()
      })
    )
    raiz.querySelector('[data-vaciar]').addEventListener('click', () => {
      mesa = []
      pintar()
    })

    pintar()
  }
</script>
