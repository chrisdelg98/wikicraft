---
import Base from '../../layouts/Base.astro'
import Buscador from '../../components/Buscador.astro'
import TarjetaEntidad from '../../components/TarjetaEntidad.astro'
import Icono from '../../components/Icono.astro'
import {
  codigosIdioma,
  ui,
  modulosVisibles,
  entidadesDe,
  rutaModulo,
  grafo,
  RUTA_ENCANTADOR
} from '../../lib/datos.js'

export function getStaticPaths() {
  return codigosIdioma.map((idioma) => ({ params: { idioma } }))
}

const { idioma } = Astro.params

// Seleccion a mano, y no las primeras entidades que salgan de la etapa inicial:
// eso devolvia ocho biomas seguidos, que no le sirven de nada a quien acaba de
// aparecer en un mundo nuevo. Esto es, literalmente, lo primero que hace
// cualquiera al empezar una partida.
const PRIMEROS_PASOS = [
  'oak_planks',
  'stick',
  'crafting_table',
  'wooden_pickaxe',
  'furnace',
  'torch',
  'chest',
  'bread'
]

const primerosPasos = PRIMEROS_PASOS.filter((id) => grafo.has(id))
---

<Base idioma={idioma}>
  {/* Ni "overflow-hidden" ni "isolate": lo primero recortaba la lista de
      resultados del buscador contra el borde del bloque, y lo segundo la
      encerraba en su propia capa. La trama se queda debajo por orden de
      aparicion, que basta y no encierra nada. */}
  <section class="relative mb-12 bloque px-4 py-12 text-center sm:py-16">
    {/* La cuadricula y las casillas que se encienden, en dos capas anidadas.

        La de fuera recorta a ras de la tarjeta. La de dentro se estira 32px por
        cada lado para que las casillas cubran tambien las orillas donde no
        cabia una entera, y lleva la trama pegada a su propia esquina: al
        compartir caja con las casillas, lo que se enciende cae siempre justo
        entre dos lineas.

        El recorte va aqui y no en la seccion: en la seccion recortaria la lista
        del buscador contra el borde, que es el fallo que ya costo un rato la
        primera vez.

        Las casillas SI reciben el puntero. El contenido viene despues en el
        HTML y se queda por encima, asi que sobre el titulo o el buscador no se
        enciende nada. */}
    <div class="absolute inset-0 overflow-hidden" aria-hidden="true">
      <div class="rejilla-viva absolute -inset-8">
        <div class="trama pointer-events-none absolute inset-0"></div>
        {Array.from({ length: 600 }, () => <span />)}
      </div>
    </div>

    {/* El contenido no intercepta el raton, solo sus piezas.

        Este div ocupa toda la franja central aunque el texto no la llene, asi
        que tal cual apagaba la rejilla en la mitad de la portada: pasabas el
        raton por un hueco vacio y no se encendia nada, porque debajo del
        puntero seguia estando este contenedor.

        Cada pieza se lo devuelve por su cuenta, y con "w-fit" su caja se
        ajusta al texto en vez de ocupar la linea entera. El resultado es el
        que se quiere: se ilumina todo el hueco libre y las letras hacen de
        sombra, que ademas es lo que hace un bloque de verdad. El texto se
        sigue pudiendo seleccionar. */}
    <div class="pointer-events-none relative">
      <h1 class="pointer-events-auto mx-auto w-fit max-w-2xl text-4xl sm:text-5xl">
        {ui(idioma, 'portada.titulo')}
      </h1>
      <p class="pointer-events-auto mx-auto mt-3 w-fit max-w-xl text-texto-suave">
        {ui(idioma, 'portada.subtitulo')}
      </p>

      <div class="pointer-events-auto mx-auto mt-6 max-w-xl text-left">
        <Buscador idioma={idioma} />
      </div>

      <p class="pointer-events-auto mx-auto mt-2 w-fit text-sm text-texto-suave">
        {ui(idioma, 'buscador.atajo')}
      </p>
    </div>
  </section>

  {/* La calculadora no es un modulo mas: es lo unico del sitio que hace algo
      en vez de contarlo, y desde el listado de encantamientos no se llega. */}
  <section class="mb-12">
    <a
      href={`/${idioma}/${RUTA_ENCANTADOR}/`}
      class="flex flex-wrap items-center gap-x-5 gap-y-2 bloque bloque-pulsable bg-superficie-alta p-5"
    >
      <Icono modulo="enchantments" clase="h-10 w-10 shrink-0 text-acento" />
      <span class="min-w-0 flex-1">
        <span class="titulo block text-2xl">{ui(idioma, 'encantador.titulo')}</span>
        <span class="mt-1 block text-texto-suave">{ui(idioma, 'encantador.subtitulo')}</span>
      </span>
      <span class="shrink-0 bloque bg-acento-fondo px-4 py-2 font-bold text-acento-contraste">
        {ui(idioma, 'encantador.abrir')}
      </span>
    </a>
  </section>

  <section class="mb-12">
    <h2 class="titulo-seccion">{ui(idioma, 'portada.explora')}</h2>
    {/* Antes eran tres lineas sueltas: icono, nombre y un numero a secas. El
        numero no dice que hay dentro, y el nombre de un modulo tampoco se lo
        dice a quien no conoce todavia la wiki. La linea de debajo si, y es lo
        que convierte la cuadricula en algo que se lee en vez de contarse. */}
    <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-3">
      {
        modulosVisibles.map((modulo) => (
          <li>
            <a
              href={`/${idioma}/${rutaModulo(idioma, modulo)}/`}
              class="group flex h-full gap-3 bloque bloque-pulsable p-3"
            >
              {/* Dos copias del icono: la verde se va por arriba y la blanca
                  llega por abajo, detras del relleno. Con una sola habria que
                  cambiarle el color a mitad de camino, y ahi es donde antes
                  desaparecia. */}
              <span class="hueco-icono grid h-12 w-12 shrink-0 place-items-center bloque bg-superficie-alta">
                <Icono modulo={modulo} clase="icono-sale h-7 w-7 text-acento" />
                <Icono modulo={modulo} clase="icono-entra h-7 w-7 text-acento-contraste" />
              </span>

              <span class="min-w-0 flex-1">
                <span class="flex items-baseline justify-between gap-2">
                  <span class="titulo text-xl">{ui(idioma, `nav.${modulo}`)}</span>
                  <span class="shrink-0 text-sm font-bold text-texto-suave tabular-nums">
                    {entidadesDe(modulo).length}
                  </span>
                </span>
                <span class="mt-0.5 block text-sm leading-snug text-texto-suave">
                  {ui(idioma, `modulo.${modulo}`)}
                </span>
              </span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>

  {
    primerosPasos.length > 0 && (
      <section>
        <h2 class="titulo-seccion">{ui(idioma, 'portada.primerosPasos')}</h2>
        <ul class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
          {primerosPasos.map((id) => (
            <li>
              <TarjetaEntidad idioma={idioma} id={id} />
            </li>
          ))}
        </ul>
      </section>
    )
  }
</Base>
