---
/**
 * Generador de nombres para el yunque.
 *
 * Deliberadamente corto: escribes, eliges un adorno y copias. Sin colores (no
 * se pueden teclear en el yunque de una partida normal) y sin nada del plano
 * astral de Unicode (se ve como cajas dentro del juego). Lo que sale de aqui se
 * pega y funciona.
 */
import Base from '../../layouts/Base.astro'
import { codigosIdioma, ui, RUTA_ENCANTADOR } from '../../lib/datos.js'
import { ESTILOS, ADORNOS, LIMITE } from '../../lib/nombres.js'

export function getStaticPaths() {
  return codigosIdioma.map((idioma) => ({ params: { idioma } }))
}

const { idioma } = Astro.params
---

<Base
  idioma={idioma}
  titulo={ui(idioma, 'nombres.titulo')}
  descripcion={ui(idioma, 'nombres.subtitulo')}
>
  <header class="mb-8 border-b-2 border-borde pb-5">
    <h1 class="text-4xl sm:text-5xl">{ui(idioma, 'nombres.titulo')}</h1>
    <p class="mt-4 max-w-4xl text-lg leading-relaxed">{ui(idioma, 'nombres.subtitulo')}</p>
  </header>

  <section class="mb-8">
    <h2 class="titulo-seccion">{ui(idioma, 'nombres.paso1')}</h2>
    <input
      type="text"
      data-texto
      value="Afortunado"
      maxlength={LIMITE}
      spellcheck="false"
      class="h-14 w-full bloque bg-superficie-alta px-4 text-xl font-semibold sm:max-w-md"
    />
  </section>

  <section class="mb-8">
    <h2 class="titulo-seccion">{ui(idioma, 'nombres.paso2')}</h2>
    <div class="flex flex-wrap gap-1.5">
      {
        ADORNOS.map((a, i) => (
          <button
            type="button"
            data-adorno={a.id}
            aria-pressed={i === 1 ? 'true' : 'false'}
            class="bloque bloque-pulsable px-3 py-1.5 text-base font-semibold aria-pressed:bg-acento-fondo aria-pressed:text-acento-contraste"
          >
            {a.id === 'ninguno' ? ui(idioma, 'nombres.sinAdorno') : `${a.izq.trim()}${a.der.trim()}`}
          </button>
        ))
      }
    </div>
  </section>

  <section class="mb-8">
    <h2 class="titulo-seccion">{ui(idioma, 'nombres.paso3')}</h2>
    <ul class="space-y-2">
      {
        ESTILOS.map((e) => (
          <li
            data-estilo={e.id}
            class="flex flex-wrap items-center gap-x-4 gap-y-2 bloque bg-superficie-alta p-3"
          >
            <span class="w-28 shrink-0 text-sm font-bold text-texto-suave">
              {ui(idioma, `nombres.estilo.${e.id}`)}
            </span>
            <span data-salida class="min-w-0 flex-1 text-xl break-words" />
            <span data-cuenta class="shrink-0 text-sm tabular-nums text-texto-suave" />
            <button
              type="button"
              data-copiar
              data-copiado={ui(idioma, 'nombres.copiado')}
              class="shrink-0 bloque bloque-pulsable bg-acento-fondo px-3 py-1.5 text-sm font-bold text-acento-contraste"
            >
              {ui(idioma, 'nombres.copiar')}
            </button>
          </li>
        ))
      }
    </ul>
  </section>

  {/* El aviso no es un detalle: renombrar aparte le costo ocho niveles de mas a
      quien nos conto el caso que dio origen a esta pagina. */}
  <section class="bloque bg-superficie-alta p-4">
    <h2 class="titulo-seccion">{ui(idioma, 'nombres.cuidado')}</h2>
    <p class="max-w-4xl">{ui(idioma, 'nombres.cuidadoTexto')}</p>
    <a
      href={`/${idioma}/${RUTA_ENCANTADOR}/`}
      class="mt-3 inline-block font-semibold hover:text-acento"
    >
      {ui(idioma, 'nombres.verOptimizador')}
    </a>
  </section>
</Base>

<script>
  import { ESTILOS, ADORNOS, componer, largo, LIMITE } from '../../lib/nombres.js'

  const campo = document.querySelector('[data-texto]')
  if (campo) {
    const filas = [...document.querySelectorAll('[data-estilo]')]
    let adorno = ADORNOS[1]

    const pintar = () => {
      const texto = campo.value
      for (const fila of filas) {
        const estilo = ESTILOS.find((e) => e.id === fila.dataset.estilo)
        const valor = componer(texto, estilo, adorno)
        fila.querySelector('[data-salida]').textContent = valor
        const cuenta = fila.querySelector('[data-cuenta]')
        cuenta.textContent = `${largo(valor)}/${LIMITE}`
        // Pasarse del limite no es un aviso estetico: el yunque corta.
        cuenta.classList.toggle('text-[var(--etapa-nether)]', largo(valor) > LIMITE)
        cuenta.classList.toggle('font-bold', largo(valor) > LIMITE)
      }
    }

    campo.addEventListener('input', pintar)

    for (const boton of document.querySelectorAll('[data-adorno]')) {
      boton.addEventListener('click', () => {
        adorno = ADORNOS.find((a) => a.id === boton.dataset.adorno)
        for (const otro of document.querySelectorAll('[data-adorno]')) {
          otro.setAttribute('aria-pressed', String(otro === boton))
        }
        pintar()
      })
    }

    for (const boton of document.querySelectorAll('[data-copiar]')) {
      boton.addEventListener('click', async () => {
        const valor = boton.closest('[data-estilo]').querySelector('[data-salida]').textContent
        try {
          await navigator.clipboard.writeText(valor)
        } catch {
          // Sin permiso de portapapeles queda el camino de toda la vida.
          const auxiliar = document.createElement('textarea')
          auxiliar.value = valor
          document.body.append(auxiliar)
          auxiliar.select()
          document.execCommand('copy')
          auxiliar.remove()
        }
        const antes = boton.textContent
        boton.textContent = boton.dataset.copiado
        setTimeout(() => (boton.textContent = antes), 1200)
      })
    }

    pintar()
  }
</script>
