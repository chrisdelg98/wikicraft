---
import Base from '../layouts/Base.astro'
import Buscador from '../components/Buscador.astro'
import Icono from '../components/Icono.astro'
import { idiomaBase, ui, modulos, rutaModulo, entidadesDe } from '../lib/datos.js'

// Una sola pagina 404 para todo el sitio, en el idioma base. Los enlaces rotos
// llegan desde cualquier sitio y no siempre traen idioma, asi que intentar
// adivinarlo complicaria mas de lo que aporta.
const idioma = idiomaBase
---

<Base idioma={idioma} titulo={ui(idioma, 'error404.titulo')}>
  <section class="mx-auto max-w-2xl py-8 text-center">
    <p class="text-6xl font-extrabold text-acento">404</p>

    <h1 class="mt-4 text-3xl font-extrabold">{ui(idioma, 'error404.titulo')}</h1>
    <p class="mt-3 text-lg text-texto-suave">{ui(idioma, 'error404.explicacion')}</p>

    <div class="mt-8 text-left">
      <Buscador idioma={idioma} />
    </div>

    <h2 class="mt-12 mb-4 text-xl font-bold">{ui(idioma, 'portada.explora')}</h2>
    <ul class="grid grid-cols-2 gap-3 sm:grid-cols-3">
      {
        modulos.map((modulo) => (
          <li>
            <a
              href={`/${idioma}/${rutaModulo(idioma, modulo)}/`}
              class="flex h-full items-center gap-2 bloque bloque-pulsable p-3 text-left"
            >
              <Icono modulo={modulo} clase="h-6 w-6 shrink-0 text-acento" />
              <span class="font-bold">{ui(idioma, `nav.${modulo}`)}</span>
              <span class="ml-auto text-sm text-texto-suave">{entidadesDe(modulo).length}</span>
            </a>
          </li>
        ))
      }
    </ul>
  </section>
</Base>
