---
import '../styles/global.css'
import Buscador from '../components/Buscador.astro'
import SpriteIconos from '../components/SpriteIconos.astro'
import Icono from '../components/Icono.astro'
import { ui, idiomas, modulos, modulosVisibles, rutaModulo, rutaDe, grafo } from '../lib/datos.js'

const {
  idioma,
  titulo,
  descripcion = ui(idioma, 'sitio.descripcion'),
  // Cuando estamos en la ficha de una entidad, el selector de idioma lleva a la
  // MISMA entidad en el otro idioma, no a la portada. Cambiar de idioma no
  // deberia costarte el sitio donde estabas.
  idEntidad = null
} = Astro.props

const tituloCompleto = titulo
  ? `${titulo} · ${ui(idioma, 'sitio.nombre')}`
  : `${ui(idioma, 'sitio.nombre')} · ${ui(idioma, 'sitio.lema')}`

// Modulo en el que estas ahora, para dejar su pestana encendida. Se deduce de
// la ruta y no hay que pasarlo desde cada pagina, asi que no se puede olvidar.
const rutaActual = Astro.url.pathname
const moduloActivo = modulos.find((m) =>
  rutaActual.startsWith(`/${idioma}/${rutaModulo(idioma, m)}/`)
)

const otrosIdiomas = idiomas
  .filter((i) => i.codigo !== idioma)
  .map((i) => ({
    ...i,
    url: idEntidad && grafo.has(idEntidad) ? rutaDe(i.codigo, idEntidad) : `/${i.codigo}/`
  }))
---

<!doctype html>
<html lang={idioma}>
  <head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{tituloCompleto}</title>
    <meta name="description" content={descripcion} />
    <link rel="icon" href="/favicon.svg" type="image/svg+xml" />
    <link rel="manifest" href="/manifest.webmanifest" />

    {/* La fuente de los titulos, pedida cuanto antes. Sin esto el navegador no
        se entera de que la necesita hasta despues de leer el CSS entero, y el
        titulo se pinta primero con la del sistema y salta a la otra medio
        segundo despues. Son 20 KB. */}
    <link
      rel="preload"
      href="/fuentes/jersey10-400.woff2"
      as="font"
      type="font/woff2"
      crossorigin
    />
    <meta name="theme-color" content="#3f7f2b" />

    {
      idiomas.map((i) => (
        <link
          rel="alternate"
          hreflang={i.codigo}
          href={
            idEntidad && grafo.has(idEntidad)
              ? `${Astro.site ?? ''}${rutaDe(i.codigo, idEntidad)}`.replace(/([^:]\/)\/+/g, '$1')
              : `${Astro.site ?? ''}/${i.codigo}/`.replace(/([^:]\/)\/+/g, '$1')
          }
        />
      ))
    }

    {/* Se aplica el tema guardado antes de pintar, para que no haya un
        parpadeo blanco al cargar en modo oscuro. */}
    <script is:inline>
      try {
        const tema = localStorage.getItem('tema')
        if (tema) document.documentElement.dataset.tema = tema
      } catch {}
    </script>
  </head>

  <body class="min-h-screen flex flex-col">
    <SpriteIconos />

    <a
      href="#contenido"
      class="sr-only focus:not-sr-only focus:absolute focus:top-2 focus:left-2 focus:z-50 focus:bloque focus:px-4 focus:py-2"
    >
      {ui(idioma, 'nav.inicio')}
    </a>

    <header class="sticky top-0 z-40 border-b-2 border-borde bg-superficie/95 backdrop-blur">
      <div class="mx-auto w-full max-w-6xl px-4 py-3">
        <div class="flex items-center gap-3">
          <a
            href={`/${idioma}/`}
            class="flex shrink-0 items-center gap-2 font-bold tracking-tight"
          >
            <span
              class="grid h-8 w-8 place-items-center bloque bg-acento-fondo text-acento-contraste"
              aria-hidden="true"
            >
              <svg viewBox="0 0 8 8" class="h-4 w-4" fill="currentColor">
                <path d="M0 0h3v3H0zM5 0h3v3H5zM0 5h3v3H0zM5 5h3v3H5z"></path>
              </svg>
            </span>
            {/* El nombre del sitio es un logotipo, asi que lleva la fuente de
                los titulos aunque no sea un encabezado. */}
            <span class="titulo hidden text-3xl sm:inline">
              {ui(idioma, 'sitio.nombre')}
            </span>
          </a>

          <div class="min-w-0 flex-1">
            <Buscador idioma={idioma} compacto={true} />
          </div>

          <div class="flex shrink-0 items-center gap-1">
            <button
              type="button"
              data-cambiar-tema
              class="grid h-9 w-9 place-items-center bloque bloque-pulsable"
              title={ui(idioma, 'tema.cambiar')}
              aria-label={ui(idioma, 'tema.cambiar')}
            >
              <svg viewBox="0 0 24 24" class="h-4 w-4" fill="currentColor" aria-hidden="true">
                <path
                  d="M12 3a9 9 0 1 0 9 9c0-.3 0-.6-.05-.9A6.5 6.5 0 0 1 12.9 3.05 9.6 9.6 0 0 0 12 3Z"
                ></path>
              </svg>
            </button>

            {
              otrosIdiomas.map((i) => (
                <a
                  href={i.url}
                  class="grid h-9 place-items-center bloque bloque-pulsable px-2 text-sm font-semibold uppercase"
                  title={`${ui(idioma, 'idioma.cambiar')}: ${i.nombreNativo}`}
                  hreflang={i.codigo}
                >
                  {i.codigo}
                </a>
              ))
            }
          </div>
        </div>

        {/* Dos navegaciones que se turnan por ancho. Los nueve modulos no caben
            en una fila por debajo de 1280 px, y una barra de desplazamiento
            horizontal ahi es fea y ademas facil de no ver: quien no la note
            creera que la wiki tiene seis secciones. Por debajo se pliegan en un
            desplegable, hecho con <details> para no gastar JavaScript en algo
            que el navegador ya sabe hacer. */}
        <nav class="mt-3" aria-label={ui(idioma, 'nav.secciones')}>
          <details class="relative xl:hidden" data-menu-secciones>
            {/* El mismo tamano que las secciones de dentro: es el mismo menu,
                solo que plegado, y verlo mas pequeno que lo que despliega hace
                que no parezca la misma cosa. */}
            <summary class="titulo flex w-full cursor-pointer list-none items-center gap-2 bloque bloque-pulsable px-2.5 py-2 text-xl [&::-webkit-details-marker]:hidden">
              <Icono modulo={moduloActivo ?? 'items'} clase="h-4 w-4 text-acento" />
              <span>{moduloActivo ? ui(idioma, `nav.${moduloActivo}`) : ui(idioma, 'nav.secciones')}</span>
              <svg viewBox="0 0 16 16" class="ml-auto h-4 w-4" fill="currentColor" aria-hidden="true">
                <path d="M3 6h10L8 12z" />
              </svg>
            </summary>

            <ul class="absolute inset-x-0 top-full z-50 mt-1 grid grid-cols-2 gap-1 bloque bg-superficie-alta p-2 shadow-lg sm:grid-cols-3">
              {
                modulosVisibles.map((modulo) => (
                  <li>
                    <a
                      href={`/${idioma}/${rutaModulo(idioma, modulo)}/`}
                      aria-current={modulo === moduloActivo ? 'page' : undefined}
                      class:list={[
                        'barrido flex items-center gap-2 bloque bloque-pulsable px-2.5 py-2 titulo text-xl whitespace-nowrap',
                        modulo === moduloActivo
                          ? 'text-acento shadow-[inset_0_-4px_0_0_var(--acento)]'
                          : 'text-texto'
                      ]}
                    >
                      <Icono modulo={modulo} clase="h-4 w-4 text-acento" />
                      {ui(idioma, `nav.${modulo}`)}
                    </a>
                  </li>
                ))
              }
            </ul>
          </details>

          <ul class="hidden flex-wrap gap-1 xl:flex">
            {
              modulosVisibles.map((modulo) => (
                <li>
                  <a
                    href={`/${idioma}/${rutaModulo(idioma, modulo)}/`}
                    aria-current={modulo === moduloActivo ? 'page' : undefined}
                    class:list={[
                      'barrido flex items-center gap-2 bloque bloque-pulsable px-2.5 py-2 titulo text-xl whitespace-nowrap',
                      // La activa no se rellena: se subraya. Asi no compite con
                      // el boton de guia, que si es una accion, y se distingue
                      // igual por el verde y la barra del pie. Sin negrita: la
                      // fuente de titulos solo tiene un peso.
                      modulo === moduloActivo
                        ? 'text-acento shadow-[inset_0_-4px_0_0_var(--acento)]'
                        : 'text-texto'
                    ]}
                  >
                    <Icono modulo={modulo} clase="h-4 w-4 text-acento" />
                    {ui(idioma, `nav.${modulo}`)}
                  </a>
                </li>
              ))
            }
          </ul>
        </nav>
      </div>
    </header>

    <main id="contenido" class="mx-auto w-full max-w-6xl flex-1 px-4 py-8">
      <slot />
    </main>

    {/* El navegador puede saltarse el pie mientras no se acerque a la pantalla.
        La altura declarada evita que la barra de desplazamiento pegue un salto
        cuando decide pintarlo de verdad. */}
    <footer
      class="border-t-2 border-borde bg-superficie"
      style="content-visibility:auto;contain-intrinsic-size:auto 5rem"
    >
      <div
        class="mx-auto w-full max-w-6xl px-4 py-6 text-sm text-texto-suave flex flex-wrap gap-x-6 gap-y-2 justify-between"
      >
        {/* La cara del creeper. Se hincha y se pone roja al pasar por encima,
            como cuando uno se acerca demasiado en el juego. Es un guino y no un
            control, asi que no lleva texto ni foco: quien no pase el raton por
            ahi no se pierde nada. */}
        <p class="flex items-center gap-2">
          <span class="creeper inline-flex" aria-hidden="true">
            <Icono modulo="creeper" clase="h-5 w-5" />
          </span>
          {ui(idioma, 'sitio.nombre')} · {ui(idioma, 'sitio.lema')}
        </p>
        <p>
          {ui(idioma, 'portada.entidades', { n: grafo.size })}
        </p>
      </div>
    </footer>

    <script>
      // Alternancia de tema. Tres estados posibles en el disco: nada (manda el
      // sistema), "claro" u "oscuro". Solo se guarda cuando el usuario elige.
      const raiz = document.documentElement
      document.querySelector('[data-cambiar-tema]')?.addEventListener('click', () => {
        const oscuroAhora =
          raiz.dataset.tema === 'oscuro' ||
          (!raiz.dataset.tema && matchMedia('(prefers-color-scheme: dark)').matches)
        const siguiente = oscuroAhora ? 'claro' : 'oscuro'
        raiz.dataset.tema = siguiente
        try {
          localStorage.setItem('tema', siguiente)
        } catch {}
      })

      // El service worker solo se registra en produccion. En desarrollo cachea
      // las paginas de localhost y acabas viendo versiones viejas del sitio sin
      // entender por que; si ya quedo uno instalado de antes, se retira.
      if ('serviceWorker' in navigator) {
        if (import.meta.env.PROD) {
          addEventListener('load', () => {
            navigator.serviceWorker.register('/sw.js').catch(() => {})
          })
        } else {
          navigator.serviceWorker
            .getRegistrations()
            .then((rs) => rs.forEach((r) => r.unregister()))
            .catch(() => {})
        }
      }
    </script>
  </body>
</html>
