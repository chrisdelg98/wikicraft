---
/**
 * La cuadricula de crafteo de una receta, con su resultado.
 *
 * Vive aparte porque se pinta en dos sitios: en la ficha de la receta y en la
 * del objeto que sale de ella. Esto ultimo es el motivo de existir del
 * componente: quien busca un ojo de arana fermentado quiere ver como se hace
 * ahi mismo, no leer que existe una receta y tener que ir a buscarla.
 *
 * La cuadricula se dibuja del tamano de la estacion, que es como se ve en el
 * juego: dos por dos si se hace en el inventario, tres por tres si hace falta
 * mesa. No es adorno, es la respuesta a "y esto puedo hacerlo sin mesa": se ve
 * antes de leer nada.
 */
import { t, ui, rutaDe, grafo, grupoDe } from '../lib/datos.js'

const { idioma, receta } = Astro.props

const enlace = (otro) =>
  grafo.has(otro)
    ? { url: rutaDe(idioma, otro), nombre: t(idioma, otro).nombre }
    : { url: null, nombre: String(otro) }

/** Etiqueta de una casilla: el nombre si es uno solo, el grupo si son varios. */
const etiqueta = (opciones) => {
  if (!opciones?.length) return null
  if (opciones.length === 1) return enlace(opciones[0]).nombre
  const grupo = grupoDe(opciones)
  return grupo
    ? ui(idioma, `grupo.${grupo}`, { n: opciones.length })
    : ui(idioma, 'grupo.cualquiera', { n: opciones.length })
}

const titulo = (opciones) =>
  opciones?.length > 1 ? opciones.map((o) => enlace(o).nombre).join(', ') : undefined

const lado = receta.estacion === 'inventario' ? 2 : 3

/**
 * Cada casilla guarda la LISTA de lo que admite, porque el juego acepta
 * etiquetas: "cualquier tronco" son diecinueve alternativas para una casilla.
 */
const conForma = receta.conForma !== false && Boolean(receta.patron)

const casillas = conForma
  ? // Se rellena siempre la cuadricula entera. Recortar las filas vacias
    // ahorraba unos pixeles y a cambio mentia: una receta de dos filas en una
    // mesa de tres deja una fila libre, y saber cual importa.
    Array.from({ length: lado * lado }, (_, i) => {
      const letra = receta.patron[Math.floor(i / lado)]?.[i % lado] ?? ' '
      return letra === ' ' ? null : (receta.clave?.[letra] ?? null)
    })
  : // Sin forma da igual la posicion, pero no la cantidad: tres azucares son
    // tres casillas. Se colocan seguidas y el resto de la cuadricula queda a la
    // vista, que es justamente lo que significa "da igual donde".
    Array.from({ length: lado * lado }, (_, i) => {
      const sueltos = (receta.ingredientes ?? []).flatMap((ing) =>
        Array.from({ length: ing.cantidad ?? 1 }, () => ing.opciones)
      )
      return sueltos[i] ?? null
    })

/**
 * Los huecos son grandes porque dentro va texto y no una textura. A 10px el
 * nombre cabia, pero "Losa de cobre cortado desgastada encerada" no se leia:
 * cabia como cabe la letra pequena de un contrato. Con 12px y hueco de 6rem
 * entra la palabra mas larga del catalogo ("descortezado") sin partirse, y lo
 * que no entra se parte por silabas en vez de desbordarse.
 *
 * En movil el hueco baja: tres de 6rem mas la bandeja se salen de una pantalla
 * de 320px, y esta wiki no se mueve en horizontal.
 *
 * Hubo un rato una version reducida para la ficha del objeto, para que la
 * receta no le robara protagonismo al resto. Duro poco: si este tamano es el
 * que se lee, el otro no se leia, y ahi es justo donde mas gente la mira.
 */
const medida = 'h-20 w-20 text-[11px] sm:h-24 sm:w-24 sm:text-xs'
const medidaResultado = 'h-24 w-24 text-xs sm:h-28 sm:w-28 sm:text-sm'
---

<div class="flex flex-wrap items-center gap-x-4 gap-y-3">
  <div class="inline-block bandeja">
    <div class="grid gap-1" style={`grid-template-columns:repeat(${lado},minmax(0,1fr))`}>
      {
        casillas.map((opciones) => (
          <span
            class:list={[
              'grid place-items-center hyphens-auto px-1 text-center leading-[1.25] font-semibold break-words hueco',
              medida,
              !opciones && 'hueco-vacio'
            ]}
            title={titulo(opciones)}
          >
            {etiqueta(opciones) ?? ''}
          </span>
        ))
      }
    </div>
  </div>

  {/* La flecha del juego dibujada a cuadros, no el caracter "→": una flecha
      tipografica al lado de una cuadricula de pixeles canta muchisimo. */}
  <svg
    viewBox="0 0 14 10"
    class="h-6 w-9 shrink-0 text-borde-fuerte sm:h-8 sm:w-12"
    fill="currentColor"
    shape-rendering="crispEdges"
    aria-hidden="true"
  >
    <rect x="0" y="3" width="8" height="4"></rect>
    <rect x="7" y="1" width="2" height="8"></rect>
    <rect x="9" y="2" width="2" height="6"></rect>
    <rect x="11" y="3" width="2" height="4"></rect>
    <rect x="13" y="4" width="1" height="2"></rect>
  </svg>

  {/* El hueco del resultado es mas grande que los demas, como en el juego. */}
  <div class="inline-block bandeja">
    <span
      class:list={[
        'grid place-items-center hyphens-auto px-2 text-center leading-[1.25] font-bold break-words bg-acento-fondo text-acento-contraste hueco',
        medidaResultado
      ]}
    >
      {receta.resultado.cantidad} × {enlace(receta.resultado.item).nombre}
    </span>
  </div>
</div>

<p class="mt-2 text-sm text-texto-suave">
  {ui(idioma, `receta.donde.${receta.estacion}`)}
  {!conForma && ` ${ui(idioma, 'receta.sinForma')}`}
</p>
