---
import { t, rutaDe, grafo, ui, facetasDe } from '../lib/datos.js'

/**
 * compacto: solo nombre y categoria, para las listas de relaciones. Una ficha
 * puede enlazar treinta y cuatro entidades, y con la tarjeta entera esa lista
 * ocupaba mas que el contenido propio de la ficha. Ahi lo que hace falta es
 * poder ojear y elegir, no leer.
 */
const { idioma, id, compacto = false } = Astro.props
const nodo = grafo.get(id)
const { entidad } = nodo
const texto = t(idioma, id)

// Dos facetas como maximo: con mas, la tarjeta vuelve a ser un muro de texto y
// deja de leerse de un vistazo, que es justo lo que se quiere evitar.
const facetas = facetasDe(nodo).slice(0, compacto ? 1 : 2)

// La etapa era una linea entera que decia "Desde el primer dia" en cien
// tarjetas seguidas. Repetida asi no informa: separa. Ahora es el filo de color
// de la izquierda, que ocupa cero y se distingue igual de un vistazo; el
// listado explica el codigo una vez, arriba, en vez de cien veces.
---

{
  compacto ? (
    <a
      href={rutaDe(idioma, id)}
      class="flex h-full flex-col gap-1 bloque bloque-pulsable px-3 py-2"
    >
      <span class="text-sm font-bold">{texto.nombre}</span>
      {facetas.length > 0 && (
        <span class="text-xs text-texto-suave">{ui(idioma, `faceta.${facetas[0]}`)}</span>
      )}
    </a>
  ) : (

<a
  href={rutaDe(idioma, id)}
  class="flex h-full flex-col gap-1.5 border-l-4 bloque bloque-pulsable py-3 pr-3 pl-2.5"
  style={`border-left-color:var(--etapa-${entidad.etapa})`}
  title={ui(idioma, `etapa.${entidad.etapa}`)}
>
  <span class="flex items-start justify-between gap-2">
    <span class="font-bold">{texto.nombre}</span>
    {
      !texto.traducido && texto.idiomaUsado && (
        <span
          class="shrink-0 text-xs font-semibold text-texto-suave"
          title={ui(idioma, 'idioma.sinTraducir', {
            idioma: ui(idioma, `idioma.nombre.${texto.idiomaUsado}`)
          })}
        >
          {texto.idiomaUsado.toUpperCase()}
        </span>
      )
    }
  </span>

  {
    facetas.length > 0 && (
      <span class="flex flex-wrap gap-1">
        {facetas.map((f) => (
          <span class="bg-fondo px-1.5 py-0.5 text-xs font-semibold text-texto-suave">
            {ui(idioma, `faceta.${f}`)}
          </span>
        ))}
      </span>
    )
  }

  {
    texto.descripcion && (
      <span class="line-clamp-2 text-sm text-texto-suave">{texto.descripcion}</span>
    )
  }
</a>
  )
}
