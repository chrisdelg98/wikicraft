---
import { ui } from '../lib/datos.js'

const { idioma, compacto = false } = Astro.props
const id = `buscador-${Math.random().toString(36).slice(2, 9)}`
---

<div
  class="relative"
  data-buscador
  data-indice={`/${idioma}/indice.json`}
  data-sin-resultados={ui(idioma, 'buscador.sinResultados')}
>
  <label for={id} class="sr-only">{ui(idioma, 'buscador.etiqueta')}</label>

  <div class="relative">
    <svg
      viewBox="0 0 24 24"
      class="pointer-events-none absolute top-1/2 left-3 h-5 w-5 -translate-y-1/2 text-texto-suave"
      fill="none"
      stroke="currentColor"
      stroke-width="2.5"
      aria-hidden="true"
    >
      <circle cx="11" cy="11" r="7"></circle>
      <path d="m20 20-3.5-3.5" stroke-linecap="round"></path>
    </svg>

    <input
      id={id}
      type="search"
      autocomplete="off"
      spellcheck="false"
      placeholder={ui(idioma, 'buscador.marcador')}
      aria-label={ui(idioma, 'buscador.etiqueta')}
      role="combobox"
      aria-expanded="false"
      aria-autocomplete="list"
      class:list={[
        'w-full bloque bg-superficie-alta pl-10 pr-3 font-medium placeholder:text-texto-suave',
        compacto ? 'py-2 text-base' : 'py-4 text-lg'
      ]}
    />
  </div>

  <div
    data-resultados
    role="listbox"
    hidden
    class="absolute inset-x-0 top-full z-50 mt-2 max-h-[70vh] overflow-y-auto bloque bg-superficie-alta p-1 shadow-lg"
  >
  </div>
</div>

<script>
  // Buscador enteramente en el navegador. El indice se descarga una sola vez,
  // la primera vez que alguien toca la caja, y a partir de ahi cada pulsacion
  // se resuelve en memoria: ni una peticion de red por tecla.

  const normalizar = (texto) =>
    texto
      .toLowerCase()
      .normalize('NFD')
      .replace(/[̀-ͯ]/g, '')

  /** Indices ya descargados, por URL, para no repetir la peticion. */
  const cache = new Map()

  const cargarIndice = (url) => {
    if (!cache.has(url)) {
      cache.set(
        url,
        fetch(url)
          .then((r) => r.json())
          .catch(() => [])
      )
    }
    return cache.get(url)
  }

  /**
   * Puntua un resultado. Lo que empieza por lo escrito va antes que lo que
   * simplemente lo contiene: quien escribe "esp" espera "Espada" arriba.
   */
  const puntuar = (registro, consulta) => {
    const nombre = normalizar(registro.n)
    if (nombre === consulta) return 100
    if (nombre.startsWith(consulta)) return 75
    if (registro.b.split(' ').some((t) => t.startsWith(consulta))) return 50
    if (registro.b.includes(consulta)) return 25
    return 0
  }

  for (const raiz of document.querySelectorAll('[data-buscador]')) {
    const entrada = raiz.querySelector('input')
    const salida = raiz.querySelector('[data-resultados]')
    const urlIndice = raiz.dataset.indice
    const plantillaVacio = raiz.dataset.sinResultados

    let registros = null
    let seleccion = -1

    const precargar = () => cargarIndice(urlIndice).then((r) => (registros = r))
    entrada.addEventListener('focus', precargar, { once: true })
    entrada.addEventListener('pointerdown', precargar, { once: true })

    const cerrar = () => {
      salida.hidden = true
      entrada.setAttribute('aria-expanded', 'false')
      seleccion = -1
    }

    const pintar = (encontrados, consulta) => {
      if (!consulta) return cerrar()

      salida.hidden = false
      entrada.setAttribute('aria-expanded', 'true')

      if (encontrados.length === 0) {
        salida.innerHTML = `<p class="px-3 py-4 text-center text-texto-suave">${plantillaVacio.replace(
          '{consulta}',
          consulta.replace(/[<>&]/g, '')
        )}</p>`
        return
      }

      salida.innerHTML = encontrados
        .map(
          (r, i) => `
            <a href="${r.u}" role="option" aria-selected="${i === 0}"
               class="flex items-center gap-3 rounded-sm px-3 py-2 hover:bg-fondo aria-selected:bg-fondo">
              <span class="h-2.5 w-2.5 shrink-0" style="background:var(--etapa-${r.e})"></span>
              <span class="min-w-0 flex-1 truncate font-semibold">${r.n}</span>
              <span class="shrink-0 text-xs text-texto-suave">${r.m}</span>
            </a>`
        )
        .join('')
      seleccion = 0
    }

    const mover = (paso) => {
      const opciones = [...salida.querySelectorAll('[role="option"]')]
      if (opciones.length === 0) return
      seleccion = (seleccion + paso + opciones.length) % opciones.length
      opciones.forEach((o, i) => o.setAttribute('aria-selected', String(i === seleccion)))
      opciones[seleccion].scrollIntoView({ block: 'nearest' })
    }

    entrada.addEventListener('input', async () => {
      const consulta = normalizar(entrada.value.trim())
      if (!consulta) return cerrar()

      registros ??= await cargarIndice(urlIndice)

      const encontrados = registros
        .map((r) => ({ r, p: puntuar(r, consulta) }))
        .filter((x) => x.p > 0)
        .sort((a, b) => b.p - a.p || a.r.n.localeCompare(b.r.n))
        .slice(0, 8)
        .map((x) => x.r)

      pintar(encontrados, entrada.value.trim())
    })

    entrada.addEventListener('keydown', (e) => {
      if (e.key === 'ArrowDown') {
        e.preventDefault()
        mover(1)
      } else if (e.key === 'ArrowUp') {
        e.preventDefault()
        mover(-1)
      } else if (e.key === 'Enter') {
        const activa = salida.querySelector('[aria-selected="true"]')
        if (activa) {
          e.preventDefault()
          activa.click()
        }
      } else if (e.key === 'Escape') {
        cerrar()
        entrada.blur()
      }
    })

    document.addEventListener('click', (e) => {
      if (!raiz.contains(e.target)) cerrar()
    })
  }

  // La barra inclinada enfoca el buscador, como en tantas herramientas.
  document.addEventListener('keydown', (e) => {
    if (e.key !== '/' || e.metaKey || e.ctrlKey) return
    const activo = document.activeElement
    if (activo && ['INPUT', 'TEXTAREA'].includes(activo.tagName)) return
    e.preventDefault()
    document.querySelector('[data-buscador] input')?.focus()
  })
</script>
