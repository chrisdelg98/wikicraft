---
import TarjetaEntidad from './TarjetaEntidad.astro'
import Icono from './Icono.astro'
import ResumenAldeanos from './ResumenAldeanos.astro'
import ResumenPociones from './ResumenPociones.astro'
import {
  ui,
  entidadesDe,
  rutaModulo,
  t,
  normalizar,
  facetasDe,
  gruposFaceta,
  RUTA_ENCANTADOR
} from '../lib/datos.js'

const { idioma, modulo, pagina = 1, faceta = null } = Astro.props

/**
 * Cuantas fichas por pagina.
 *
 * Estaba en 60 y partia los mobs en dos paginas de 60 y 23. Como los filtros
 * solo afinan lo que hay en pantalla, pedir "los del Nether" daba dos en la
 * primera pagina y once en la segunda, que no es una respuesta.
 *
 * Con 100 caben enteros los siete modulos que se pueden abarcar de una vez
 * (mobs, encantamientos, herramientas, biomas, pociones, aldeanos, granjas) y
 * siguen paginados los dos que motivaron la paginacion: objetos y crafteos. El
 * peso apenas cambia, porque una tarjeta son unos 700 bytes.
 */
export const POR_PAGINA = 100

// Primero lo que sirve desde el principio, que es por donde deberia empezar
// quien no sabe todavia que busca. Dentro de cada etapa, alfabetico.
const ORDEN = ['inicio', 'hierro', 'diamante', 'nether', 'end']

const delModulo = entidadesDe(modulo)
  .map((e) => ({
    id: e.entidad.id,
    etapa: e.entidad.etapa,
    facetas: facetasDe(e),
    nombre: t(idioma, e.entidad.id).nombre
  }))
  .sort(
    (a, b) => ORDEN.indexOf(a.etapa) - ORDEN.indexOf(b.etapa) || a.nombre.localeCompare(b.nombre)
  )

const todas = faceta ? delModulo.filter((x) => x.facetas.includes(faceta)) : delModulo

const totalPaginas = Math.max(1, Math.ceil(todas.length / POR_PAGINA))
const actual = Math.min(Math.max(1, pagina), totalPaginas)
const visibles = todas.slice((actual - 1) * POR_PAGINA, actual * POR_PAGINA)

const etapasPresentes = ORDEN.filter((e) => visibles.some((x) => x.etapa === e))

/**
 * Las categorias se cuentan sobre el MODULO ENTERO, no sobre la pagina.
 *
 * Contadas por pagina, "Comida 3" en la pagina 1 de catorce era una respuesta
 * falsa: hay 41. Y como ademas el filtro solo tachaba lo que ya estaba en
 * pantalla, pedir la comida daba tres objetos y dejaba fuera treinta y ocho.
 *
 * Ahora cada categoria es una pagina de verdad y el chip es un enlace. Deja de
 * ser un filtro que afina lo que ves y pasa a ser una forma de llegar, que es
 * lo que hace falta cuando el modulo no cabe de una vez.
 */
const facetasDelModulo = [...new Set(delModulo.flatMap((x) => x.facetas))]
  .map((f) => ({ clave: f, cuantas: delModulo.filter((x) => x.facetas.includes(f)).length }))
  .filter(({ cuantas }) => cuantas < delModulo.length)
  .sort((a, b) => b.cuantas - a.cuantas)

const grupos = gruposFaceta(facetasDelModulo)

const hayFiltros = etapasPresentes.length > 1

/** Modulos con tabla comparativa propia. Solo tiene sentido en la pagina 1. */
const hayGuia = actual === 1 && ['villagers', 'potions'].includes(modulo)

// La lista de encantamientos dice cual hace que; la calculadora dice en que
// orden ponerlos. Es la pregunta siguiente de quien esta leyendo esta pagina,
// asi que el enlace va aqui y no escondido en el menu.
const hayEncantador = actual === 1 && modulo === 'enchantments'
const titulo = ui(idioma, `nav.${modulo}`)
const raiz = `/${idioma}/${rutaModulo(idioma, modulo)}`

/** Cada categoria es una URL propia, asi que se puede compartir y volver. */
export const RUTA_CATEGORIA = 'tipo'
const urlCategoria = (clave) => (clave ? `${raiz}/${RUTA_CATEGORIA}/${clave}/` : `${raiz}/`)

const base = faceta ? `${raiz}/${RUTA_CATEGORIA}/${faceta}` : raiz
const urlPagina = (n) => (n === 1 ? `${base}/` : `${base}/pagina/${n}/`)

/**
 * Los chips de categoria y los numeros de pagina son el mismo boton: se elige
 * algo y se va a otra pagina. Iban con clases parecidas pero no iguales, y una
 * diferencia de dos pixeles de alto basta para que se lean como dos cosas
 * distintas. Aqui se escriben una vez para que no vuelvan a separarse.
 */
const PASTILLA = 'bloque px-3 py-1.5 text-sm'
const PASTILLA_INACTIVA = `${PASTILLA} bloque-pulsable font-semibold`
const PASTILLA_ACTIVA = `${PASTILLA} bg-acento-fondo font-bold text-acento-contraste`

// Ventana de paginas alrededor de la actual, para no pintar veintitantos
// numeros seguidos en pantallas pequenas.
const ventana = []
for (let n = Math.max(1, actual - 2); n <= Math.min(totalPaginas, actual + 2); n++) ventana.push(n)
---

<div class="mb-6 flex items-center gap-3">
  <Icono modulo={modulo} clase="h-10 w-10 shrink-0 text-acento" />
  <div>
    <h1 class="text-4xl">
      {titulo}
      {faceta && <span class="text-texto-suave"> · {ui(idioma, `faceta.${faceta}`)}</span>}
    </h1>
    <p class="text-texto-suave">
      {ui(idioma, 'listado.resumen', { n: todas.length, pagina: actual, total: totalPaginas })}
    </p>
  </div>
</div>

{/* Las categorias a la vista y no detras de un boton. Es lo primero que se
    quiere hacer al llegar a una lista de mil objetos, y esconderlo en un panel
    convertia un clic en tres. Son enlaces, no botones: llevan a una pagina de
    verdad, se pueden compartir y el navegador sabe volver.

    Van sobre la misma superficie clara que el resto de tarjetas, y no sueltos
    sobre el fondo de la pagina. El motivo es el color: el boton verde es el
    mismo en los dos sitios, pero sobre el beige del fondo se apagaba y sobre el
    blanco de una tarjeta se ve vivo. Mismo verde, distinto vecino. Ahora todos
    los botones verdes del sitio tienen el mismo vecino. */}
{
  grupos.length > 0 && (
    <div class="mb-6 space-y-2 bloque bg-superficie-alta p-3">
      {grupos.map(({ familia, facetas }) => (
        <nav class="flex flex-wrap items-center gap-2" aria-label={ui(idioma, `faceta.grupo.${familia}`)}>
          <span class="text-sm font-bold text-texto-suave">{ui(idioma, `faceta.grupo.${familia}`)}</span>
          <a
            href={urlCategoria(null)}
            aria-current={faceta ? undefined : 'page'}
            class={faceta ? PASTILLA_INACTIVA : PASTILLA_ACTIVA}
          >
            {ui(idioma, 'filtro.todas')}
          </a>
          {facetas.map(({ clave, cuantas }) => (
            <a
              href={urlCategoria(clave)}
              aria-current={clave === faceta ? 'page' : undefined}
              class={clave === faceta ? PASTILLA_ACTIVA : PASTILLA_INACTIVA}
            >
              {ui(idioma, `faceta.${clave}`)}
              {/* La cuenta hereda el color de la pastilla y solo se apaga un
                  poco. Llevaba "text-acento-contraste/70", que Tailwind no
                  compila cuando el color viene de una variable: la clase salia
                  en el HTML, no existia en el CSS, y el numero se quedaba con
                  el color que le tocara. Con "opacity" no hay que compilar. */}
              <span class:list={['ml-1.5', clave === faceta ? 'opacity-75' : 'text-texto-suave']}>
                {cuantas}
              </span>
            </a>
          ))}
        </nav>
      ))}
    </div>
  )
}

{
  hayEncantador && (
    <a
      href={`/${idioma}/${RUTA_ENCANTADOR}/`}
      class="mb-6 flex flex-wrap items-center gap-x-4 gap-y-2 bloque bloque-pulsable bg-superficie-alta p-4"
    >
      <span class="min-w-0 flex-1">
        <span class="titulo block text-xl">{ui(idioma, 'encantador.titulo')}</span>
        <span class="mt-0.5 block text-sm text-texto-suave">
          {ui(idioma, 'encantador.subtitulo')}
        </span>
      </span>
      <span class="shrink-0 bloque bg-acento-fondo px-3 py-1.5 text-sm font-bold text-acento-contraste">
        {ui(idioma, 'encantador.abrir')}
      </span>
    </a>
  )
}

{/* La clave del filo de color, una vez y no en cada tarjeta. Es exactamente el
    espacio que se ha ahorrado: cinco palabras arriba en lugar de cien lineas
    repetidas mas abajo. */}
{
  etapasPresentes.length > 1 && (
    <p class="mb-5 flex flex-wrap items-center gap-x-4 gap-y-1 text-xs text-texto-suave">
      <span class="font-bold">{ui(idioma, 'etapa.explicacion')}</span>
      {etapasPresentes.map((etapa) => (
        <span class="flex items-center gap-1.5">
          <span class="h-2.5 w-2.5 shrink-0" style={`background:var(--etapa-${etapa})`} aria-hidden="true" />
          {ui(idioma, `etapa.${etapa}`)}
        </span>
      ))}
    </p>
  )
}

{/* La guia comparativa NO va encima de la lista: son tres tablas y empujaban
    los resultados fuera de la pantalla. Vive en un panel, como los filtros. */}
{
  hayGuia && (
    <dialog data-panel-guia class="ancho" aria-label={ui(idioma, 'guia.abrir')}>
      <div class="sticky top-0 flex items-center justify-between gap-4 border-b-2 border-borde bg-superficie px-4 py-3">
        <h2 class="text-xl">{ui(idioma, `guia.titulo.${modulo}`)}</h2>
        <button
          type="button"
          data-cerrar-guia
          class="bloque bloque-pulsable px-2.5 py-1 text-sm font-semibold"
          aria-label={ui(idioma, 'filtro.cerrar')}
        >
          ✕
        </button>
      </div>

      <div class="px-4 pt-5 pb-2">
        {modulo === 'villagers' && <ResumenAldeanos idioma={idioma} />}
        {modulo === 'potions' && <ResumenPociones idioma={idioma} />}
      </div>
    </dialog>
  )
}

{/* Barra compacta: solo lo que se usa siempre. Los filtros por categoria y
    etapa viven en un panel aparte, porque ocupaban media pantalla antes de
    dejar ver un solo resultado. */}
{
  (hayFiltros || hayGuia || visibles.length > 12) && (
    <div class="mb-6">
      <div class="flex flex-wrap items-stretch gap-3">
        {/* El campo manda: crece hasta ocupar todo lo que sobre. Es lo que mas
            se usa y antes competia por el sitio con dos botones. */}
        <div class="relative min-w-0 flex-1 basis-full sm:basis-64">
          <svg
            viewBox="0 0 24 24"
            class="pointer-events-none absolute top-1/2 left-4 h-5 w-5 -translate-y-1/2 text-texto-suave"
            fill="none"
            stroke="currentColor"
            stroke-width="2.5"
            aria-hidden="true"
          >
            <circle cx="11" cy="11" r="7" />
            <path d="m20 20-3.5-3.5" stroke-linecap="round" />
          </svg>
          {/* Altura fija en las tres piezas de la barra. Con relleno vertical
              cada una acababa midiendo distinto, porque el campo y los botones
              no comparten ni tamano de letra ni interlineado. */}
          <input
            type="search"
            data-filtro-texto
            placeholder={ui(idioma, 'filtro.buscarEnLista')}
            aria-label={ui(idioma, 'filtro.buscarEnLista')}
            class="h-12 w-full bloque bg-superficie-alta pr-4 pl-12 text-base placeholder:text-texto-suave"
          />
        </div>

        {hayGuia && (
          <button
            type="button"
            data-abrir-guia
            class="flex h-12 shrink-0 items-center gap-2 bloque bloque-pulsable bg-acento-fondo px-4 font-bold text-acento-contraste"
          >
            <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M2 2h5v12H2zM9 2h5v12H9zM3 4h3v1H3zM10 4h3v1h-3zM3 6h3v1H3zM10 6h3v1h-3z" />
            </svg>
            {ui(idioma, 'guia.abrir')}
          </button>
        )}

        {hayFiltros && (
          <button
            type="button"
            data-abrir-filtros
            class="flex h-12 shrink-0 items-center gap-2 bloque bloque-pulsable px-4 font-semibold"
          >
            <svg viewBox="0 0 16 16" class="h-4 w-4" fill="currentColor" aria-hidden="true">
              <path d="M1 3h14v2H1zM3 7h10v2H3zM6 11h4v2H6z" />
            </svg>
            {ui(idioma, 'filtro.abrir')}
            <span
              data-cuenta-filtros
              hidden
              class="grid h-5 min-w-5 place-items-center bg-acento-fondo px-1 text-xs font-bold text-acento-contraste"
            />
          </button>
        )}
      </div>

      <p
        data-resumen-filtro
        data-plantilla={ui(idioma, 'buscador.resultados', { n: '§' })}
        class="mt-2 text-sm text-texto-suave"
      />
    </div>
  )
}

{
  hayFiltros && (
    <dialog data-panel-filtros aria-label={ui(idioma, 'filtro.abrir')}>
      <div class="flex items-center justify-between gap-4 border-b-2 border-borde px-4 py-3">
        <h2 class="text-xl">{ui(idioma, 'filtro.abrir')}</h2>
        <button
          type="button"
          data-cerrar-filtros
          class="bloque bloque-pulsable px-2.5 py-1 text-sm font-semibold"
          aria-label={ui(idioma, 'filtro.cerrar')}
        >
          ✕
        </button>
      </div>

      <div class="space-y-6 px-4 py-4">
        {etapasPresentes.length > 1 && (
          <div>
            <h3 class="mb-2 text-sm font-bold uppercase tracking-wide text-texto-suave">
              {ui(idioma, 'etapa.explicacion')}
            </h3>
            <div class="flex flex-wrap gap-2">
              <button
                type="button"
                data-filtro-etapa=""
                aria-pressed="true"
                class="bloque bloque-pulsable px-3 py-1.5 text-sm font-semibold aria-pressed:border-b-acento aria-pressed:bg-superficie-alta"
              >
                {ui(idioma, 'filtro.todas')}
              </button>
              {etapasPresentes.map((etapa) => (
                <button
                  type="button"
                  data-filtro-etapa={etapa}
                  aria-pressed="false"
                  class="flex items-center gap-1.5 bloque bloque-pulsable px-3 py-1.5 text-sm font-semibold aria-pressed:border-b-acento aria-pressed:bg-superficie-alta"
                >
                  <span class="h-2.5 w-2.5" style={`background:var(--etapa-${etapa})`} aria-hidden="true" />
                  {ui(idioma, `etapa.${etapa}`)}
                </button>
              ))}
            </div>
          </div>
        )}

        <p class="text-sm text-texto-suave">{ui(idioma, 'filtro.ambito')}</p>
      </div>

      <div class="flex flex-wrap justify-end gap-2 border-t-2 border-borde px-4 py-3">
        <button type="button" data-limpiar-filtros class="bloque bloque-pulsable px-3 py-2 text-sm font-semibold">
          {ui(idioma, 'filtro.limpiar')}
        </button>
        <button
          type="button"
          data-cerrar-filtros
          class="bloque bloque-pulsable bg-acento-fondo px-4 py-2 text-sm font-bold text-acento-contraste"
        >
          {ui(idioma, 'filtro.aplicar')}
        </button>
      </div>
    </dialog>
  )
}

<ul data-lista class="grid grid-cols-1 gap-3 sm:grid-cols-2 lg:grid-cols-4">
  {
    visibles.map(({ id, etapa, facetas, nombre }) => (
      <li data-etapa={etapa} data-facetas={facetas.join(' ')} data-nombre={normalizar(nombre)}>
        <TarjetaEntidad idioma={idioma} id={id} />
      </li>
    ))
  }
</ul>

{/* El estado vacio decia "nada coincide" y era mentira: el filtro solo mira la
    pagina que tienes delante, asi que buscar "madera" en la 1 de 14 daba cero
    con dieciocho objetos esperando en otras paginas. Ahora lo dice y ofrece la
    salida, que es el buscador de arriba: ese si mira toda la wiki. */}
<div data-vacio hidden class="mt-8 text-center">
  <p class="text-texto-suave">{ui(idioma, 'filtro.soloEstaPagina')}</p>
  <button
    type="button"
    data-buscar-en-todo
    data-plantilla={ui(idioma, 'filtro.buscarEnTodo', { consulta: '§' })}
    class="mt-3 bloque bloque-pulsable bg-acento-fondo px-4 py-2 text-sm font-bold text-acento-contraste"
  ></button>
</div>

{/* Se esconde mientras filtras por nombre: la paginacion es de la lista
    completa, no de lo que el filtro deja a la vista, y dejarla debajo de "no
    hay nada" invitaba a pensar que la pagina 2 traeria mas de lo mismo. */}
{
  totalPaginas > 1 && (
    <nav data-paginacion class="mt-8 flex flex-wrap items-center justify-center gap-2" aria-label="paginas">
      {actual > 1 && (
        <a href={urlPagina(actual - 1)} class={PASTILLA_INACTIVA}>
          {ui(idioma, 'listado.anterior')}
        </a>
      )}
      {!ventana.includes(1) && (
        <a href={urlPagina(1)} class={PASTILLA_INACTIVA}>
          1
        </a>
      )}
      {ventana.map((n) =>
        n === actual ? (
          <span aria-current="page" class={PASTILLA_ACTIVA}>
            {n}
          </span>
        ) : (
          <a href={urlPagina(n)} class={PASTILLA_INACTIVA}>
            {n}
          </a>
        )
      )}
      {!ventana.includes(totalPaginas) && (
        <a href={urlPagina(totalPaginas)} class={PASTILLA_INACTIVA}>
          {totalPaginas}
        </a>
      )}
      {actual < totalPaginas && (
        <a href={urlPagina(actual + 1)} class={PASTILLA_INACTIVA}>
          {ui(idioma, 'listado.siguiente')}
        </a>
      )}

      {totalPaginas > 5 && (
        <label class="ml-2 flex items-center gap-2 text-sm text-texto-suave">
          {ui(idioma, 'listado.irA')}
          <select
            data-salto-pagina
            class="bloque bg-superficie-alta px-2 py-1.5 text-sm font-semibold text-texto"
          >
            {Array.from({ length: totalPaginas }, (_, i) => i + 1).map((n) => (
              <option value={urlPagina(n)} selected={n === actual}>
                {n}
              </option>
            ))}
          </select>
        </label>
      )}
    </nav>
  )
}

<style>
  [data-lista] > li[hidden] {
    display: none;
  }
</style>

<script>
  // Filtrado dentro de la pagina. Para buscar en todo el sitio esta el buscador
  // de arriba; esto es para afinar lo que ya tienes delante.
  const lista = document.querySelector('[data-lista]')
  if (lista) {
    const elementos = [...lista.children]
    const vacio = document.querySelector('[data-vacio]')

    const panel = document.querySelector('[data-panel-filtros]')
    const contador = document.querySelector('[data-cuenta-filtros]')
    const resumen = document.querySelector('[data-resumen-filtro]')
    const paginacion = document.querySelector('[data-paginacion]')

    // Las categorias ya no se filtran aqui: cada una es su propia pagina. Lo
    // que queda es afinar lo que ya tienes delante, por etapa y por nombre.
    let etapa = ''
    let texto = ''
    // Lo que se escribio tal cual, para poder repetirlo en el buscador global.
    let crudo = ''

    const normalizar = (t) => t.toLowerCase().normalize('NFD').replace(/[̀-ͯ]/g, '')

    const aplicar = () => {
      let visibles = 0
      for (const li of elementos) {
        const coincide =
          (!etapa || li.dataset.etapa === etapa) && (!texto || li.dataset.nombre.includes(texto))
        li.hidden = !coincide
        if (coincide) visibles++
      }
      if (vacio) {
        vacio.hidden = visibles > 0
        if (visibles === 0 && texto) {
          const boton = vacio.querySelector('[data-buscar-en-todo]')
          boton.textContent = boton.dataset.plantilla.replace('§', crudo)
        }
      }

      // El boton lleva cuantos filtros hay puestos, porque una vez cerrado el
      // panel no hay otra forma de saber que la lista esta recortada.
      const activos = [etapa].filter(Boolean).length
      if (contador) {
        contador.hidden = activos === 0
        contador.textContent = String(activos)
      }
      if (paginacion) paginacion.hidden = Boolean(texto)
      if (resumen) {
        const filtrando = activos > 0 || texto
        resumen.textContent = filtrando
          ? (resumen.dataset.plantilla ?? '§').replace('§', String(visibles))
          : ''
      }
    }

    /** Deja pulsado solo el boton elegido dentro de su grupo. */
    const marcar = (selector, elegido) => {
      for (const otro of document.querySelectorAll(selector)) {
        otro.setAttribute('aria-pressed', String(otro === elegido))
      }
    }

    document.querySelector('[data-filtro-texto]')?.addEventListener('input', (e) => {
      crudo = e.target.value.trim()
      texto = normalizar(crudo)
      aplicar()
    })

    // Pasarle la palabra al buscador de la cabecera, que esta en todas las
    // paginas y si tiene el indice entero. Es el unico sitio del que puede
    // salir una respuesta completa.
    document.querySelector('[data-buscar-en-todo]')?.addEventListener('click', () => {
      const global = document.querySelector('[data-buscador] input')
      if (!global) return
      global.value = crudo
      global.dispatchEvent(new Event('input', { bubbles: true }))
      global.focus()
      global.scrollIntoView({ block: 'center', behavior: 'smooth' })
    })

    for (const boton of document.querySelectorAll('[data-filtro-etapa]')) {
      boton.addEventListener('click', () => {
        etapa = boton.dataset.filtroEtapa
        marcar('[data-filtro-etapa]', boton)
        aplicar()
      })
    }

    // Paneles. Se usa <dialog> nativo: trae el fondo, el foco atrapado y el
    // cierre con Escape sin una linea de JavaScript propia.
    const guia = document.querySelector('[data-panel-guia]')
    document.querySelector('[data-abrir-guia]')?.addEventListener('click', () => guia?.showModal())
    for (const boton of document.querySelectorAll('[data-cerrar-guia]')) {
      boton.addEventListener('click', () => guia?.close())
    }
    guia?.addEventListener('click', (e) => {
      if (e.target === guia) guia.close()
    })

    document.querySelector('[data-abrir-filtros]')?.addEventListener('click', () => {
      panel?.showModal()
    })
    for (const boton of document.querySelectorAll('[data-cerrar-filtros]')) {
      boton.addEventListener('click', () => panel?.close())
    }
    document.querySelector('[data-limpiar-filtros]')?.addEventListener('click', () => {
      etapa = ''
      marcar('[data-filtro-etapa]', document.querySelector('[data-filtro-etapa=""]'))
      aplicar()
    })
    // Un clic en el fondo tambien cierra, que es lo que espera todo el mundo.
    panel?.addEventListener('click', (e) => {
      if (e.target === panel) panel.close()
    })

    // Salto directo de pagina: con veintitrés páginas, ir de una en una no es
    // una forma razonable de llegar a la mitad de la lista.
    document.querySelector('[data-salto-pagina]')?.addEventListener('change', (e) => {
      if (e.target.value) location.href = e.target.value
    })

    aplicar()
  }
</script>
