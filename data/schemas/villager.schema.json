{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikicraft/schemas/villager.schema.json",
  "title": "Aldeano",
  "description": "Profesion de aldeano con su mesa de trabajo y su tabla de comercio por nivel.",

  "allOf": [{ "$ref": "_comun.schema.json#/$defs/entidad" }],

  "type": "object",
  "required": ["id", "tipo", "mesaDeTrabajo", "niveles", "etapa"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "_comun.schema.json#/$defs/id" },
    "tipo": { "const": "aldeano" },
    "desdeVersion": { "$ref": "_comun.schema.json#/$defs/version" },
    "hastaVersion": { "$ref": "_comun.schema.json#/$defs/version" },
    "etapa": { "$ref": "_comun.schema.json#/$defs/etapa" },
    "etiquetas": { "type": "array", "items": { "type": "string" } },

    "mesaDeTrabajo": {
      "$ref": "_comun.schema.json#/$defs/referencia",
      "description": "Bloque que asigna esta profesion a un aldeano desempleado."
    },

    "niveles": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "required": ["nivel", "tradeos"],
        "additionalProperties": false,
        "properties": {
          "nivel": {
            "type": "integer",
            "minimum": 1,
            "maximum": 5,
            "description": "1 novato, 2 aprendiz, 3 oficial, 4 experto, 5 maestro."
          },
          "tradeos": {
            "type": "array",
            "minItems": 1,
            "items": { "$ref": "#/$defs/tradeo" }
          }
        }
      }
    }
  },
  "additionalProperties": false,

  "$defs": {
    "tradeo": {
      "type": "object",
      "required": ["id", "entrega", "recibe"],
      "additionalProperties": false,
      "properties": {
        "id": { "$ref": "_comun.schema.json#/$defs/id" },

        "entrega": {
          "type": "object",
          "required": ["item"],
          "additionalProperties": false,
          "description": "Lo que el aldeano da al jugador.",
          "properties": {
            "item": { "$ref": "_comun.schema.json#/$defs/referencia" },
            "cantidad": { "$ref": "_comun.schema.json#/$defs/cantidad" },
            "encantamiento": {
              "$ref": "_comun.schema.json#/$defs/referencia",
              "description": "Presente cuando el item entregado es un libro encantado. Es la relacion que conecta un encantamiento con el aldeano que lo vende."
            },
            "nivelEncantamiento": { "type": "integer", "minimum": 1, "maximum": 5 }
          }
        },

        "recibe": {
          "type": "array",
          "minItems": 1,
          "maxItems": 2,
          "description": "Lo que el jugador paga. Como maximo dos ingredientes, que es el limite del juego.",
          "items": { "$ref": "_comun.schema.json#/$defs/ingrediente" }
        },

        "precioMinimo": {
          "type": "integer",
          "minimum": 1,
          "description": "Coste mas bajo alcanzable en esmeraldas, aplicando descuentos por curacion y reputacion."
        },

        "precioMaximo": { "type": "integer", "minimum": 1 }
      }
    }
  }
}
