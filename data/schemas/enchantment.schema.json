{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikicraft/schemas/enchantment.schema.json",
  "title": "Encantamiento",

  "allOf": [{ "$ref": "_comun.schema.json#/$defs/entidad" }],

  "type": "object",
  "required": ["id", "tipo", "nivelMaximo", "categoria", "aplicableA"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "_comun.schema.json#/$defs/id" },
    "tipo": { "const": "encantamiento" },
    "desdeVersion": { "$ref": "_comun.schema.json#/$defs/version" },
    "hastaVersion": { "$ref": "_comun.schema.json#/$defs/version" },
    "etiquetas": { "type": "array", "items": { "type": "string" } },

    "nivelMaximo": {
      "type": "integer",
      "minimum": 1,
      "maximum": 5
    },

    "categoria": {
      "type": "string",
      "enum": ["dano", "proteccion", "recoleccion", "utilidad", "maldicion"]
    },

    "aplicableA": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "description": "Familias de equipo sobre las que funciona. Se resuelve contra la categoria de cada herramienta o armadura, no contra items concretos, para no listar cada variante de material.",
      "items": {
        "type": "string",
        "enum": [
          "espada",
          "hacha",
          "pico",
          "pala",
          "azada",
          "arco",
          "ballesta",
          "tridente",
          "casco",
          "pechera",
          "pantalones",
          "botas",
          "elitros",
          "escudo",
          "cana",
          "tijeras",
          "mechero"
        ]
      }
    },

    "incompatibleCon": {
      "$ref": "_comun.schema.json#/$defs/referencias",
      "description": "Otros encantamientos que no pueden convivir en la misma pieza. La relacion debe declararse en ambos sentidos."
    },

    "esTesoro": {
      "type": "boolean",
      "default": false,
      "description": "Si no puede obtenerse en la mesa de encantamientos y solo aparece en botin, comercio o pesca."
    },

    "esMaldicion": {
      "type": "boolean",
      "default": false
    },

    "obtenidoDe": {
      "$ref": "_comun.schema.json#/$defs/referencias",
      "description": "Aldeanos, estructuras o mobs que permiten conseguirlo."
    }
  },
  "additionalProperties": false
}
