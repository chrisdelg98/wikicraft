{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://wikicraft/schemas/mob.schema.json",
  "title": "Mob",
  "description": "Criatura del juego. Las debilidades son valores cerrados y no texto libre: es lo que permite responder a 'como mato esto' sin depender de que alguien haya escrito esa frase.",

  "allOf": [{ "$ref": "_comun.schema.json#/$defs/entidad" }],

  "type": "object",
  "required": ["id", "tipo", "categoria", "dimension", "etapa"],
  "properties": {
    "$schema": { "type": "string" },
    "id": { "$ref": "_comun.schema.json#/$defs/id" },
    "tipo": { "const": "mob" },
    "desdeVersion": { "$ref": "_comun.schema.json#/$defs/version" },
    "hastaVersion": { "$ref": "_comun.schema.json#/$defs/version" },
    "etapa": { "$ref": "_comun.schema.json#/$defs/etapa" },
    "relevancia": { "$ref": "_comun.schema.json#/$defs/relevancia" },
    "etiquetas": { "type": "array", "items": { "type": "string" } },

    "categoria": {
      "type": "string",
      "enum": ["pasivo", "neutral", "hostil", "jefe"]
    },

    "dimension": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": { "$ref": "_comun.schema.json#/$defs/dimension" },
      "description": "Mundos donde aparece de forma natural. Es lista y no un solo valor porque el enderman sale en los tres y el esqueleto en dos. Obligatorio: es la primera pregunta de quien mira un mob que no conoce, y un campo opcional acaba sin rellenar."
    },

    "vida": {
      "type": "number",
      "exclusiveMinimum": 0,
      "description": "Puntos de salud. Dos puntos son un corazon; la interfaz muestra corazones, no este numero. No es obligatorio porque minecraft-data no lo trae: es un dato que anadimos a mano y por eso llega despues que el resto."
    },

    "dano": {
      "type": "number",
      "minimum": 0,
      "description": "Dano por ataque en dificultad normal."
    },

    "experiencia": { "type": "integer", "minimum": 0 },

    "noMuerto": {
      "type": "boolean",
      "default": false,
      "description": "Determina si le afectan Castigo y las pociones de curacion al reves."
    },

    "apareceEn": {
      "$ref": "_comun.schema.json#/$defs/referencias",
      "description": "Biomas y estructuras donde aparece."
    },

    "botin": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["item", "maximo"],
        "additionalProperties": false,
        "properties": {
          "item": { "$ref": "_comun.schema.json#/$defs/referencia" },
          "minimo": { "type": "integer", "minimum": 0, "default": 0 },
          "maximo": { "type": "integer", "minimum": 1 },
          "probabilidad": {
            "type": "number",
            "exclusiveMinimum": 0,
            "maximum": 1,
            "description": "Entre 0 y 1. La interfaz lo muestra como porcentaje."
          },
          "soloAlMorirPorJugador": { "type": "boolean", "default": false }
        }
      }
    },

    "debilidades": {
      "type": "array",
      "uniqueItems": true,
      "items": { "$ref": "_comun.schema.json#/$defs/debilidad" }
    }
  },
  "additionalProperties": false
}
